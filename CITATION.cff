    given-names: Gaoshan
    alias: zenggs05
repository-code: "https://github.com/zenggs05/DFT-Tutorials"
url: "https://zenggs05.github.io/DFT-Tutorials/"
license: MIT
type: software
keywords:
  - density functional theory
  - DFT
  - first-principles
  - VASP
  - Gaussian
  - CP2K
  - OpenMX
  - computational chemistry
  - computational materials science
  - tutorial
