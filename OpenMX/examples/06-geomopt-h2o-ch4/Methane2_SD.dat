#
# CH4 molecule: steepest-descent optimization (MD.Type Opt) from a distorted start
# The C atom is displaced by 0.3 Ang along x from the centre of the regular tetrahedron
# of H atoms (C-H = 1.09 Ang in the regular geometry).
# OpenMX 4.0 (+patch 4.0.1), database DFT_DATA19
#
System.CurrrentDirectory    ./          # official spelling has three r's
System.Name                 ch4_sd
DATA.PATH                   /opt/openmx4.0/DFT_DATA19   # EDIT: directory that contains PAO/ and VPS/
level.of.stdout             1
level.of.fileout            0

Species.Number              2
<Definition.of.Atomic.Species
  C    C6.0-s2p2d1   C_PBE19
  H    H6.0-s2p1     H_PBE19
Definition.of.Atomic.Species>

Atoms.Number                5
Atoms.SpeciesAndCoordinates.Unit   Ang
<Atoms.SpeciesAndCoordinates
  1   C    5.30000   5.00000   5.00000   2.0  2.0
  2   H    5.62900   5.62900   5.62900   0.5  0.5
  3   H    4.37100   4.37100   5.62900   0.5  0.5
  4   H    4.37100   5.62900   4.37100   0.5  0.5
  5   H    5.62900   4.37100   4.37100   0.5  0.5
Atoms.SpeciesAndCoordinates>
Atoms.UnitVectors.Unit      Ang
<Atoms.UnitVectors
  10.0   0.0   0.0
   0.0  10.0   0.0
   0.0   0.0  10.0
Atoms.UnitVectors>

scf.XcType                  GGA-PBE
scf.SpinPolarization        off
scf.ElectronicTemperature   300.0       # K
scf.energycutoff            250.0       # Ry
scf.EigenvalueSolver        Cluster
scf.Mixing.Type             RMM-DIISK
scf.Init.Mixing.Weight      0.10
scf.Min.Mixing.Weight       0.01
scf.Max.Mixing.Weight       0.30
scf.Mixing.History          20
scf.Mixing.StartPulay       8
scf.maxIter                 100
scf.criterion               1.0e-9      # Hartree

#
# Steepest descent with a variable prefactor (robust but slow)
#
MD.Type                     Opt         # steepest descent
MD.maxIter                  200
MD.Opt.criterion            3.0e-4      # Hartree/Bohr (default)
