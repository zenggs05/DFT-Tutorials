# Silicon (fcc primitive cell): SCF + band structure, path L-G-X-W-K-G.
# Same path as in ../08-unfold-si-supercell, so the two results can be overlaid.
# OpenMX 4.0.

System.CurrrentDirectory    ./
System.Name                 si
DATA.PATH                   /opt/openmx4.0/DFT_DATA19   # EDIT: dir containing PAO/ and VPS/
level.of.stdout             1
level.of.fileout            1

Species.Number              1
<Definition.of.Atomic.Species
  Si   Si7.0-s2p2d1   Si_PBE19
Definition.of.Atomic.Species>

Atoms.Number                2
Atoms.SpeciesAndCoordinates.Unit   FRAC
<Atoms.SpeciesAndCoordinates
  1  Si  0.00  0.00  0.00   2.0 2.0
  2  Si  0.25  0.25  0.25   2.0 2.0
Atoms.SpeciesAndCoordinates>

Atoms.UnitVectors.Unit      Ang
<Atoms.UnitVectors
  0.000  2.715  2.715
  2.715  0.000  2.715
  2.715  2.715  0.000
Atoms.UnitVectors>

scf.XcType                  GGA-PBE
scf.SpinPolarization        off
scf.ElectronicTemperature   300.0
scf.energycutoff            220.0
scf.maxIter                 100
scf.EigenvalueSolver        Band
scf.Kgrid                   10 10 10
scf.Mixing.Type             RMM-DIISK
scf.Init.Mixing.Weight      0.10
scf.Min.Mixing.Weight       0.001
scf.Max.Mixing.Weight       0.30
scf.Mixing.History          20
scf.Mixing.StartPulay       8
scf.criterion               1.0e-8

MD.Type                     Nomd

Band.dispersion             on
<Band.KPath.UnitCell
  5.430  0.000  0.000
  0.000  5.430  0.000
  0.000  0.000  5.430
Band.KPath.UnitCell>
Band.Nkpath                 5
<Band.kpath
  26   0.50 0.50 0.50    0.00 0.00 0.00    L  g
  30   0.00 0.00 0.00    1.00 0.00 0.00    g  X
  15   1.00 0.00 0.00    1.00 0.50 0.00    X  W
  11   1.00 0.50 0.00    0.75 0.75 0.00    W  K
  32   0.75 0.75 0.00    0.00 0.00 0.00    K  g
Band.kpath>
