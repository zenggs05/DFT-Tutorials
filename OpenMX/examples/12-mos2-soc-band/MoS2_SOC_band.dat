#
# Monolayer MoS2 (2H), band structure with spin-orbit coupling + kSpin keywords
# Target: OpenMX 4.0 + patch 4.0.1, database DFT_DATA19 (j-dependent VPS)
# a = 3.16 Ang (approx. experimental), Mo-S vertical distance 1.565 Ang (approximate),
# vacuum along c (20 Ang cell). Geometry not optimized.
#
System.CurrrentDirectory    ./
System.Name                 mos2_soc
DATA.PATH                   /opt/openmx4.0/DFT_DATA19   # EDIT: directory that contains PAO/ and VPS/
level.of.stdout             1
level.of.fileout            0
HS.fileout                  on         # mos2_soc.scfout for kSpin (spin texture)

# Standard basis; Mo_PBE19: 14, S_PBE19: 6 valence electrons
Species.Number              2
<Definition.of.Atomic.Species
  Mo   Mo7.0-s3p2d2     Mo_PBE19
  S    S7.0-s2p2d1f1    S_PBE19
Definition.of.Atomic.Species>

Atoms.Number                3
Atoms.SpeciesAndCoordinates.Unit   FRAC
<Atoms.SpeciesAndCoordinates
  1  Mo   0.0000000000  0.0000000000  0.5000000   7.0  7.0
  2  S    0.3333333333  0.6666666667  0.5782500   3.0  3.0
  3  S    0.3333333333  0.6666666667  0.4217500   3.0  3.0
Atoms.SpeciesAndCoordinates>

# hexagonal cell, 120 degrees between a and b
Atoms.UnitVectors.Unit      Ang
<Atoms.UnitVectors
   3.160000   0.000000   0.000000
  -1.580000   2.736640   0.000000
   0.000000   0.000000  20.000000
Atoms.UnitVectors>

scf.XcType                  GGA-PBE
scf.SpinPolarization        nc
scf.SpinOrbit.Coupling      on
scf.EigenvalueSolver        Band
scf.Kgrid                   12 12 1
scf.energycutoff            220.0
scf.ElectronicTemperature   300.0
scf.maxIter                 200
scf.criterion               1.0e-9
scf.Mixing.Type             RMM-DIISK
scf.Init.Mixing.Weight      0.10
scf.Min.Mixing.Weight       0.001
scf.Max.Mixing.Weight       0.40
scf.Mixing.History          30
scf.Mixing.StartPulay       6

MD.Type                     Nomd

# Band path G-M-K-G-Kp (Kp = K prime); for a = (a,0,0), b = (-a/2, a*sqrt(3)/2, 0):
# M = (1/2,0,0), K = (1/3,1/3,0), Kp = -K = (-1/3,-1/3,0)
Band.dispersion             on
Band.Nkpath                 4
<Band.kpath
  40  0.0000000000  0.0000000000  0.0   0.5000000000  0.0000000000  0.0   G   M
  25  0.5000000000  0.0000000000  0.0   0.3333333333  0.3333333333  0.0   M   K
  45  0.3333333333  0.3333333333  0.0   0.0000000000  0.0000000000  0.0   K   G
  45  0.0000000000  0.0000000000  0.0  -0.3333333333 -0.3333333333  0.0   G  Kp
Band.kpath>

#
# Keywords read by the post-processing code kSpin (ignored by openmx):
#   ./kSpin MoS2_SOC_band.dat   (after the SCF has written mos2_soc.scfout)
# BandDispersion uses the Band.kpath block above.
#
Filename.scfout             mos2_soc.scfout
Filename.outdata            mos2_soc_BD
Calc.Type                   BandDispersion
Energy.Range                -1.5  0.5
