#
# NiO, AFM-II order along [111], rhombohedral 4-atom cell
# GGA-PBE reference calculation WITHOUT +U (compare with the +U inputs)
# Target: OpenMX 4.0 (for 3.9 delete the scf.Generation.Kpoint line)
# a(rock salt) = 4.177 Ang (close to experiment), h = a/2 = 2.0885 Ang
#

System.CurrrentDirectory    ./           # note: official spelling has three r
System.Name                 nio_gga
level.of.stdout             1
level.of.fileout            1
DATA.PATH                   /opt/openmx4.0/DFT_DATA19   # EDIT: directory that contains PAO/ and VPS/

#
# Species: Ni_PBE19S has 16 valence electrons (3p6 3d8 4s2), O_PBE19 has 6
#
Species.Number      2
<Definition.of.Atomic.Species
  Ni   Ni6.0S-s3p2d2   Ni_PBE19S
  O    O6.0-s2p2d1     O_PBE19
Definition.of.Atomic.Species>

#
# Atoms: columns = index species x y z n_up n_down
# Ni1 and Ni2 get opposite initial moments (AFM-II); n_up + n_down = valence
#
Atoms.Number        4
Atoms.SpeciesAndCoordinates.Unit   Ang
<Atoms.SpeciesAndCoordinates
  1  Ni   0.00000   0.00000   0.00000   10.0   6.0
  2  Ni   2.08850   2.08850   0.00000    6.0  10.0
  3  O    2.08850   0.00000   0.00000    3.0   3.0
  4  O    2.08850   2.08850   2.08850    3.0   3.0
Atoms.SpeciesAndCoordinates>

Atoms.UnitVectors.Unit   Ang
<Atoms.UnitVectors
  4.17700   2.08850   2.08850
  2.08850   4.17700   2.08850
  2.08850   2.08850   4.17700
Atoms.UnitVectors>

#
# SCF
#
scf.XcType                  GGA-PBE
scf.SpinPolarization        on
scf.ElectronicTemperature   300.0        # K
scf.energycutoff            250.0        # Ry, always set explicitly
scf.EigenvalueSolver        Band
scf.Kgrid                   7 7 7
scf.Generation.Kpoint       GCenter      # OpenMX 4.0 keyword (default GCenter)
scf.maxIter                 300
scf.Mixing.Type             RMM-DIISK
scf.Init.Mixing.Weight      0.05
scf.Min.Mixing.Weight       0.001
scf.Max.Mixing.Weight       0.20
scf.Mixing.History          30
scf.Mixing.StartPulay       15
scf.criterion               1.0e-8       # Hartree

MD.Type                     nomd

#
# DOS for PDOS comparison (post-process with DosMain)
#
Dos.fileout                 on
Dos.Erange                 -10.0  10.0   # eV, relative to the chemical potential
Dos.Kgrid                   11 11 11
