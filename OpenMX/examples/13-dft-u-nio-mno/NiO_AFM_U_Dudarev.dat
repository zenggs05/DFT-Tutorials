#
# NiO, AFM-II order along [111], rhombohedral 4-atom cell
# GGA-PBE + U, simplified rotationally invariant form (Dudarev), U_eff = 5.0 eV on Ni 1d
# Target: OpenMX 4.0 (for 3.9 delete the scf.Generation.Kpoint line)
# This file is also the template used by scan_U.sh (it edits "1d <value>" on the Ni line)
#

System.CurrrentDirectory    ./
System.Name                 nio_dudarev_u5
level.of.stdout             1
level.of.fileout            1
DATA.PATH                   /opt/openmx4.0/DFT_DATA19   # EDIT: directory that contains PAO/ and VPS/

Species.Number      2
<Definition.of.Atomic.Species
  Ni   Ni6.0S-s3p2d2   Ni_PBE19S
  O    O6.0-s2p2d1     O_PBE19
Definition.of.Atomic.Species>

#
# DFT+U part
# One value per radial function, in the order s, p, d (f), exactly matching
# the PAO definitions above: Ni6.0S-s3p2d2 -> 1s 2s 3s 1p 2p 1d 2d
#                            O6.0-s2p2d1   -> 1s 2s 1p 2p 1d
#
scf.Hubbard.U               on
scf.DFTU.Type               1            # 1: simplified (Dudarev), only U is read
scf.Hubbard.Occupation      dual         # onsite|full|dual, default=dual
<Hubbard.U.values           # eV
  Ni  1s 0.0 2s 0.0 3s 0.0 1p 0.0 2p 0.0 1d 5.0 2d 0.0
  O   1s 0.0 2s 0.0 1p 0.0 2p 0.0 1d 0.0
Hubbard.U.values>

#
# Atoms: last column = orbital-polarization flag (read only when +U is on)
#
Atoms.Number        4
Atoms.SpeciesAndCoordinates.Unit   Ang
<Atoms.SpeciesAndCoordinates
  1  Ni   0.00000   0.00000   0.00000   10.0   6.0  off
  2  Ni   2.08850   2.08850   0.00000    6.0  10.0  off
  3  O    2.08850   0.00000   0.00000    3.0   3.0  off
  4  O    2.08850   2.08850   2.08850    3.0   3.0  off
Atoms.SpeciesAndCoordinates>

Atoms.UnitVectors.Unit   Ang
<Atoms.UnitVectors
  4.17700   2.08850   2.08850
  2.08850   4.17700   2.08850
  2.08850   2.08850   4.17700
Atoms.UnitVectors>

scf.XcType                  GGA-PBE
scf.SpinPolarization        on           # +U requires on or nc
scf.ElectronicTemperature   300.0
scf.energycutoff            250.0
scf.EigenvalueSolver        Band
scf.Kgrid                   7 7 7
scf.Generation.Kpoint       GCenter
scf.maxIter                 300
scf.Mixing.Type             RMM-DIISH    # Hamiltonian mixing, recommended for +U
scf.Init.Mixing.Weight      0.05
scf.Min.Mixing.Weight       0.001
scf.Max.Mixing.Weight       0.20
scf.Mixing.History          30
scf.Mixing.StartPulay       15
scf.criterion               1.0e-8
scf.restart                 off          # scan_U.sh switches this to on in RESTART=1 mode

MD.Type                     nomd

Dos.fileout                 on
Dos.Erange                 -10.0  10.0
Dos.Kgrid                   11 11 11
