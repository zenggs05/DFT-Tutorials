# C60 molecule, same geometry/basis/cutoff as C60_cluster_elpa.dat,
# but solved with the O(N) divide-conquer (DC) method.
# Compare Utot with the cluster result to see the DC truncation error. OpenMX 4.0.

System.CurrrentDirectory    ./
System.Name                 c60_dc
DATA.PATH                   /opt/openmx4.0/DFT_DATA19   # EDIT: dir containing PAO/ and VPS/
level.of.stdout             1
level.of.fileout            0          # no cube files: this is a timing/accuracy test

