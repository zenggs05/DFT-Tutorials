# Silicon: optical conductivity and dielectric function (CDDF, Kubo-Greenwood). OpenMX 4.0.
# SCF on 10x10x10 k points, optical matrix elements on a denser CDDF.Kgrid.
# The manual shows that eps(omega) of Si needs ~50x50x50 or more for convergence;
# 30x30x30 is used here to keep the example affordable.

System.CurrrentDirectory    ./
System.Name                 si_cddf
DATA.PATH                   /opt/openmx4.0/DFT_DATA19   # EDIT: dir containing PAO/ and VPS/
level.of.stdout             1
level.of.fileout            1

Species.Number              1
<Definition.of.Atomic.Species
  Si   Si7.0-s2p2d1   Si_PBE19
Definition.of.Atomic.Species>

Atoms.Number                2
Atoms.SpeciesAndCoordinates.Unit   FRAC
<Atoms.SpeciesAndCoordinates
  1  Si  0.00  0.00  0.00   2.0 2.0
  2  Si  0.25  0.25  0.25   2.0 2.0
Atoms.SpeciesAndCoordinates>

Atoms.UnitVectors.Unit      Ang
<Atoms.UnitVectors
  0.000  2.715  2.715
  2.715  0.000  2.715
  2.715  2.715  0.000
Atoms.UnitVectors>

scf.XcType                  GGA-PBE
scf.SpinPolarization        off        # CDDF (optics) supports collinear calculations only
scf.ElectronicTemperature   300.0
scf.energycutoff            220.0
scf.maxIter                 100
scf.EigenvalueSolver        Band
scf.Kgrid                   10 10 10
scf.Mixing.Type             RMM-DIISK
scf.Init.Mixing.Weight      0.10
scf.Min.Mixing.Weight       0.001
scf.Max.Mixing.Weight       0.30
scf.Mixing.History          20
scf.Mixing.StartPulay       8
scf.criterion               1.0e-8

MD.Type                     Nomd

CDDF.start                         on
CDDF.FWHM                          0.2      # eV, Lorentzian broadening (default 0.2)
CDDF.maximum_energy               10.0      # eV, output range starts at 0 eV (default 10)
CDDF.additional_maximum_energy     1.0      # eV, states up to 11 eV are included (default 0)
CDDF.frequency.grid.total_number  2000      # energy step = 10 eV / 2000 = 0.005 eV (default 10000)
CDDF.Kgrid                        30 30 30
CDDF.shift_ChemP                   0.0      # eV, new in 4.0 (default 0)
