# Silicon: COHP/COOP between nearest and second-nearest neighbours (OpenMX >= 4.0).
# COHP is evaluated together with the DOS, so Dos.fileout must be on.
# After the run:  make cohp (in openmx4.0/source);  cohp si_cohp.cohp < cohp_answers.txt

System.CurrrentDirectory    ./
System.Name                 si_cohp
DATA.PATH                   /opt/openmx4.0/DFT_DATA19   # EDIT: dir containing PAO/ and VPS/
level.of.stdout             1
level.of.fileout            1

Species.Number              1
<Definition.of.Atomic.Species
  Si   Si7.0-s2p2d1   Si_PBE19
Definition.of.Atomic.Species>

Atoms.Number                2
Atoms.SpeciesAndCoordinates.Unit   FRAC
<Atoms.SpeciesAndCoordinates
  1  Si  0.00  0.00  0.00   2.0 2.0
  2  Si  0.25  0.25  0.25   2.0 2.0
Atoms.SpeciesAndCoordinates>

Atoms.UnitVectors.Unit      Ang
<Atoms.UnitVectors
  0.000  2.715  2.715
  2.715  0.000  2.715
  2.715  2.715  0.000
Atoms.UnitVectors>

scf.XcType                  GGA-PBE
scf.SpinPolarization        off        # CDDF (optics) supports collinear calculations only
scf.ElectronicTemperature   300.0
scf.energycutoff            220.0
scf.maxIter                 100
scf.EigenvalueSolver        Band
scf.Kgrid                   10 10 10
scf.Mixing.Type             RMM-DIISK
scf.Init.Mixing.Weight      0.10
scf.Min.Mixing.Weight       0.001
scf.Max.Mixing.Weight       0.30
scf.Mixing.History          20
scf.Mixing.StartPulay       8
scf.criterion               1.0e-8

MD.Type                     Nomd

Dos.fileout                 on
Dos.Erange                  -15.0  10.0    # eV; lower bound below the bottom of the valence band
Dos.Kgrid                   16 16 16

COHP.calc.flag              on
COHP.num.pairs              3
# serial  atom1  atom2  l1 l2 l3   (atom2 sits in the cell l1*a1 + l2*a2 + l3*a3)
<COHP.pairs
  1   1  2   0  0  0
  2   1  2  -1  0  0
  3   1  1   1  0  0
COHP.pairs>
