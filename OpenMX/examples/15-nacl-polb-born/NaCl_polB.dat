#
# NaCl (rock salt), 2-atom fcc primitive cell, LDA
# Purpose : SCF + HS.fileout -> nacl_x0.scfout for the Berry-phase code polB
#           (chapter 15, Born effective charge of Na by finite displacement)
# Target  : OpenMX 4.0 (+patch 4.0.1), DFT_DATA19
# a0      : 5.64 Ang (close to the room-temperature experimental value), a0/2 = 2.82
# make_disp.sh copies this file and shifts the x coordinate of Na (atom 1),
# which it finds by the leading columns "1  Na": keep that line format.
#

System.CurrrentDirectory    ./           # note: official spelling has three r
System.Name                 nacl_x0
level.of.stdout             1
level.of.fileout            0            # no cube files needed here
DATA.PATH                   /opt/openmx4.0/DFT_DATA19   # EDIT: directory that contains PAO/ and VPS/

#
# Species: Na_CA19 has 9 valence electrons (2s2 2p6 3s1), Cl_CA19 has 7
#
Species.Number      2
<Definition.of.Atomic.Species
  Na   Na9.0-s3p2d1    Na_CA19
  Cl   Cl7.0-s2p2d1    Cl_CA19
Definition.of.Atomic.Species>

#
# Atoms: index species x y z n_up n_down  (Ang)
#
Atoms.Number        2
Atoms.SpeciesAndCoordinates.Unit   Ang
<Atoms.SpeciesAndCoordinates
  1  Na   0.00000   0.00000   0.00000   4.5  4.5
  2  Cl   2.82000   2.82000   2.82000   3.5  3.5
Atoms.SpeciesAndCoordinates>

Atoms.UnitVectors.Unit      Ang
<Atoms.UnitVectors
  0.00000   2.82000   2.82000
  2.82000   0.00000   2.82000
  2.82000   2.82000   0.00000
Atoms.UnitVectors>

#
# SCF: insulator, tight convergence (polarization differences are small)
#
scf.XcType                  LDA          # must match *_CA19 pseudopotentials
scf.SpinPolarization        off
scf.ElectronicTemperature   300.0        # K
scf.energycutoff            220.0        # Ry, set explicitly
scf.maxIter                 200
scf.EigenvalueSolver        band
scf.Kgrid                   9 9 9
scf.Mixing.Type             rmm-diisk
scf.Init.Mixing.Weight      0.05
scf.Min.Mixing.Weight       0.001
scf.Max.Mixing.Weight       0.30
scf.Mixing.History          7
scf.Mixing.StartPulay       8
scf.criterion               1.0e-10      # Hartree

MD.Type                     nomd

#
# Write Hamiltonian and overlap matrices -> System.Name.scfout (input of polB)
#
HS.fileout                  on
