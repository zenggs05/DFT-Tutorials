# Si64 (2x2x2 conventional diamond supercell, a = 5.43 A), Quick basis Si7.0-s2p1d1.
# O(N) divide-conquer with localized natural orbitals (DC-LNO). OpenMX 4.0.
# For MD/optimization fix the number of LNOs instead of the occupation cutoff:
#   <LNOs.Num
#     Si  4
#   LNOs.Num>

System.CurrrentDirectory    ./
System.Name                 si64_dclno
DATA.PATH                   /opt/openmx4.0/DFT_DATA19   # EDIT: dir containing PAO/ and VPS/
level.of.stdout             1
level.of.fileout            0          # no cube files for large systems

Species.Number              1
<Definition.of.Atomic.Species
  Si   Si7.0-s2p1d1   Si_PBE19
Definition.of.Atomic.Species>

Atoms.Number                64
