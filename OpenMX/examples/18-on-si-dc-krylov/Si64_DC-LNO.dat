scf.XcType                  GGA-PBE
scf.SpinPolarization        off
scf.ElectronicTemperature   300.0
scf.energycutoff            200.0
scf.maxIter                 100
scf.EigenvalueSolver        DC-LNO
orderN.HoppingRanges        8.0        # Ang
orderN.LNO.Buffer           0.2        # default 0.2
orderN.LNO.Occ.Cutoff       0.1        # default 0.1
scf.dclno.threading         on         # OpenMP at the lowest parallel level (use with -nt > 1)
scf.Mixing.Type             RMM-DIISK
scf.Init.Mixing.Weight      0.05
scf.Min.Mixing.Weight       0.001
scf.Max.Mixing.Weight       0.20
scf.Mixing.History          15
scf.Mixing.StartPulay       8
scf.criterion               1.0e-8

MD.Type                     Nomd
