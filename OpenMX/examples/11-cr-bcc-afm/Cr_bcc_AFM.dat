#
# bcc Cr, simple commensurate antiferromagnet (CsCl-type) in the 2-atom cubic cell
# Target: OpenMX 4.0 + patch 4.0.1, database DFT_DATA19
# Note: real Cr has an incommensurate spin-density wave; this AFM cell is the usual approximation.
#
System.CurrrentDirectory    ./
System.Name                 cr_afm
DATA.PATH                   /opt/openmx4.0/DFT_DATA19   # EDIT: directory that contains PAO/ and VPS/
level.of.stdout             1
level.of.fileout            1          # cr_afm.sden.cube shows the +/- spin density

Species.Number              1
<Definition.of.Atomic.Species
  Cr   Cr6.0-s3p2d1   Cr_PBE19
Definition.of.Atomic.Species>

# Cr_PBE19: 14 valence electrons; atom 1 starts with +3 muB, atom 2 with -3 muB
Atoms.Number                2
Atoms.SpeciesAndCoordinates.Unit   FRAC
<Atoms.SpeciesAndCoordinates
  1  Cr   0.0  0.0  0.0    8.5  5.5
  2  Cr   0.5  0.5  0.5    5.5  8.5
Atoms.SpeciesAndCoordinates>

# simple cubic 2-atom cell, a = 2.88 Ang (close to the experimental value)
Atoms.UnitVectors.Unit      Ang
<Atoms.UnitVectors
  2.8800   0.0000   0.0000
  0.0000   2.8800   0.0000
  0.0000   0.0000   2.8800
Atoms.UnitVectors>

scf.XcType                  GGA-PBE
scf.SpinPolarization        on
scf.EigenvalueSolver        Band
scf.Kgrid                   14 14 14
scf.energycutoff            250.0
scf.ElectronicTemperature   300.0
scf.maxIter                 300
scf.criterion               1.0e-8
scf.Mixing.Type             RMM-DIISK
scf.Init.Mixing.Weight      0.02
scf.Min.Mixing.Weight       0.001
scf.Max.Mixing.Weight       0.20
scf.Mixing.History          30
scf.Mixing.StartPulay       15

MD.Type                     Nomd

Voronoi.charge              on
