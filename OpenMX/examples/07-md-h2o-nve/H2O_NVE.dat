# H2O molecule: NVE molecular dynamics with OpenMX 4.0
# One O-H bond is stretched (1.02 A) and the other is 0.97 A, starting from rest,
# so the molecule vibrates. Use it to check energy conservation (Utot + Ukc).
# Before running: edit DATA.PATH, and remove old H2O_NVE.ene / H2O_NVE.md
# (OpenMX appends to these files).

System.CurrrentDirectory    ./
System.Name                 H2O_NVE
DATA.PATH                   /opt/openmx4.0/DFT_DATA19   # EDIT: dir containing PAO/ and VPS/
level.of.stdout             1
level.of.fileout            0          # no cube files at every MD step

Species.Number              2
<Definition.of.Atomic.Species
  H   H6.0-s2p1      H_PBE19
  O   O6.0-s2p2d1    O_PBE19
Definition.of.Atomic.Species>
# To treat H as deuterium, add the mass (amu) as 4th column:  H  H6.0-s2p1  H_PBE19  2.0

Atoms.Number                3
Atoms.SpeciesAndCoordinates.Unit   Ang
<Atoms.SpeciesAndCoordinates
  1  O   5.00000   5.00000   5.30000   3.0  3.0
  2  H   5.80650   5.00000   4.67554   0.5  0.5
  3  H   4.23303   5.00000   4.70615   0.5  0.5
Atoms.SpeciesAndCoordinates>

Atoms.UnitVectors.Unit      Ang
<Atoms.UnitVectors
  10.0   0.0   0.0
   0.0  10.0   0.0
   0.0   0.0  10.0
Atoms.UnitVectors>

scf.XcType                  GGA-PBE
scf.SpinPolarization        off
scf.ElectronicTemperature   300.0      # K
scf.energycutoff            250.0      # Ry, fine grid reduces egg-box noise
scf.maxIter                 100
scf.EigenvalueSolver        Cluster    # isolated molecule
scf.Kgrid                   1 1 1
scf.Mixing.Type             RMM-DIIS
scf.Init.Mixing.Weight      0.30
scf.Min.Mixing.Weight       0.001
scf.Max.Mixing.Weight       0.40
scf.Mixing.History          7
scf.Mixing.StartPulay       5
scf.criterion               1.0e-9     # Hartree, tight for NVE

MD.Type                     NVE
MD.maxIter                  1000       # absolute number of MD steps
MD.TimeStep                 0.5        # fs
scf.ExtCharge.History       2          # density extrapolation between MD steps

# Optional initial velocities (m/s), e.g. generated by:
#   python3 gen_init_velocity.py H2O_NVE.dat --temp 300 --seed 1 >> H2O_NVE.dat
