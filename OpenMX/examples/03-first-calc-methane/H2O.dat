#
# Water molecule (H2O) single-point SCF with OpenMX 4.0
# DFT-Tutorials, OpenMX chapter 3
# Experimental gas-phase geometry: O-H = 0.9572 Ang, H-O-H = 104.52 deg.
# The molecule lies in the xz plane; its C2 axis is parallel to z.
#

System.CurrrentDirectory      ./          # official spelling: three 'r'
System.Name                   h2o
DATA.PATH                     /path/to/openmx4.0/DFT_DATA19   # EDIT: absolute path containing PAO/ and VPS/
level.of.stdout               1
level.of.fileout              1

#
# O6.0-s2p2d1: 13 basis functions; H6.0-s2p1: 5 basis functions
#
Species.Number                2
<Definition.of.Atomic.Species
  H    H6.0-s2p1      H_PBE19
  O    O6.0-s2p2d1    O_PBE19
Definition.of.Atomic.Species>

#
# O_PBE19 has 6 valence electrons -> 3.0 3.0 ; H_PBE19 has 1 -> 0.5 0.5
# A 12 Ang box is used to reduce dipole-dipole interactions between images.
#
Atoms.Number                  3
Atoms.SpeciesAndCoordinates.Unit   Ang
<Atoms.SpeciesAndCoordinates
  1   O    6.000000   6.000000   5.850000    3.0  3.0
  2   H    6.756950   6.000000   6.435870    0.5  0.5
  3   H    5.243050   6.000000   6.435870    0.5  0.5
Atoms.SpeciesAndCoordinates>
Atoms.UnitVectors.Unit        Ang
<Atoms.UnitVectors
  12.0   0.0   0.0
   0.0  12.0   0.0
   0.0   0.0  12.0
Atoms.UnitVectors>

scf.XcType                    GGA-PBE
scf.SpinPolarization          off
scf.ElectronicTemperature     300.0       # K
scf.energycutoff              200.0       # Ry
scf.maxIter                   100
scf.EigenvalueSolver          Cluster
scf.Kgrid                     1 1 1
scf.Mixing.Type               RMM-DIIS
scf.Init.Mixing.Weight        0.30
scf.Min.Mixing.Weight         0.001
scf.Max.Mixing.Weight         0.40
scf.Mixing.History            7
scf.Mixing.StartPulay         5
scf.criterion                 1.0e-8      # Hartree

MD.Type                       Nomd
MD.maxIter                    1
