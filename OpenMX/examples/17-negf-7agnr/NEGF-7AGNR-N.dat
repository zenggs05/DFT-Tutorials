scf.XcType                    GGA-PBE     # identical in Step 1 and Step 2
scf.SpinPolarization          off         # armchair ribbons are non-magnetic
scf.ElectronicTemperature     300.0
scf.energycutoff              200.0       # Ry, identical in Step 1 and Step 2
scf.maxIter                   300
scf.EigenvalueSolver          NEGF
scf.Mixing.Type               RMM-DIISK
scf.Init.Mixing.Weight        0.02
scf.Min.Mixing.Weight         0.001
scf.Max.Mixing.Weight         0.05
scf.Mixing.History            30
scf.Mixing.StartPulay         20
scf.criterion                 1.0e-7

NEGF.filename.hks.l           lead-7agnr.hks
NEGF.filename.hks.r           lead-7agnr.hks
NEGF.Num.Poles                150
NEGF.scf.Kgrid                1 1
NEGF.SCF.Iter.Band            10
NEGF.Poisson.Solver           FD
NEGF.bias.voltage             0.0

NEGF.tran.Analysis            on
NEGF.tran.energyrange         -3.0 3.0 1.0e-3
NEGF.tran.energydiv           601
NEGF.tran.Kgrid               1 1
NEGF.tran.CurrentDensity      off
NEGF.tran.Channel             on
NEGF.Channel.Nkpoint          1
<NEGF.Channel.kpoint
  0.0  0.0
NEGF.Channel.kpoint>
NEGF.Channel.Nenergy          2
<NEGF.Channel.energy
  -1.2
  1.2
NEGF.Channel.energy>
NEGF.Channel.Num              3

Dos.fileout                   on          # NEGF DOS of the extended central region
NEGF.Dos.energyrange          -3.0 3.0 5.0e-3
NEGF.Dos.energy.div           601
NEGF.Dos.Kgrid                1 1

MD.Type                       Nomd
