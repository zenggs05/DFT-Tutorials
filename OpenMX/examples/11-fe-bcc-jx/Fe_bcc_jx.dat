#
# bcc Fe, collinear FM SCF that writes fe_jx.scfout for the post-processing code jx
# Target: OpenMX 4.0 + patch 4.0.1, database DFT_DATA19
#
System.CurrrentDirectory    ./
System.Name                 fe_jx
DATA.PATH                   /opt/openmx4.0/DFT_DATA19   # EDIT: directory that contains PAO/ and VPS/
level.of.stdout             1
level.of.fileout            0          # no cube files needed
HS.fileout                  on         # -> fe_jx.scfout (Hamiltonian, overlap, density matrix)

# small basis (s2p2d2), as recommended in the manual for jx
Species.Number              1
<Definition.of.Atomic.Species
  Fe   Fe6.0H-s2p2d2   Fe_PBE19H
Definition.of.Atomic.Species>

# Fe_PBE19H: 16 valence electrons, initial moment 4 muB
Atoms.Number                1
Atoms.SpeciesAndCoordinates.Unit   FRAC
<Atoms.SpeciesAndCoordinates
  1  Fe   0.0  0.0  0.0   10.0  6.0
Atoms.SpeciesAndCoordinates>

# bcc primitive cell, a = 2.866 Ang; R = l1*a1 + l2*a2 + l3*a3 in Fe_bcc_jx.config
Atoms.UnitVectors.Unit      Ang
<Atoms.UnitVectors
  -1.4330   1.4330   1.4330
   1.4330  -1.4330   1.4330
   1.4330   1.4330  -1.4330
Atoms.UnitVectors>

scf.XcType                  GGA-PBE
scf.SpinPolarization        on         # jx supports collinear calculations only
scf.EigenvalueSolver        Band
scf.Kgrid                   16 16 16
scf.energycutoff            300.0
scf.ElectronicTemperature   300.0
scf.maxIter                 200
scf.criterion               1.0e-8
scf.Mixing.Type             RMM-DIISK
scf.Init.Mixing.Weight      0.02
scf.Min.Mixing.Weight       0.001
scf.Max.Mixing.Weight       0.20
scf.Mixing.History          30
scf.Mixing.StartPulay       15

MD.Type                     Nomd
