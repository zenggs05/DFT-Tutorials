Atoms.UnitVectors>

scf.XcType                  GGA-PBE
scf.SpinPolarization        off
scf.ElectronicTemperature   300.0      # K
scf.energycutoff            200.0      # Ry
scf.maxIter                 100
scf.EigenvalueSolver        Band
scf.Kgrid                   2 2 2      # use 1 1 1 for a quick test
scf.Mixing.Type             RMM-DIISK
scf.Init.Mixing.Weight      0.10
scf.Min.Mixing.Weight       0.001
scf.Max.Mixing.Weight       0.30
scf.Mixing.History          20
scf.Mixing.StartPulay       8
scf.criterion               1.0e-7     # Hartree
scf.ExtCharge.History       2

MD.Type                     NVT_NH
MD.maxIter                  2000       # absolute last MD step
MD.TimeStep                 2.0        # fs
# Nose-Hoover format: step  T(K)   (linear interpolation between lines)
<MD.TempControl
  2
     1    1000.0
  2000    1000.0
MD.TempControl>
NH.Mass.HeatBath            30.0       # Bohr^2 * amu, default 20
