#
# Benzene molecule: HOMO/LUMO cube files from a cluster calculation
# Target: OpenMX 4.0 + patch 4.0.1, database DFT_DATA19
# Geometry: approximate experimental bond lengths (C-C 1.397, C-H 1.084 Ang), not optimized
#
System.CurrrentDirectory    ./
System.Name                 benzene
DATA.PATH                   /opt/openmx4.0/DFT_DATA19   # EDIT: directory that contains PAO/ and VPS/
level.of.stdout             1
level.of.fileout            1          # set 2 to also print LCAO coefficients into benzene.out

Species.Number              2
<Definition.of.Atomic.Species
  C   C6.0-s2p2d1   C_PBE19
  H   H6.0-s2p1     H_PBE19
Definition.of.Atomic.Species>

Atoms.Number                12
Atoms.SpeciesAndCoordinates.Unit   Ang
<Atoms.SpeciesAndCoordinates
  1  C    1.39700   0.00000   0.00000   2.0  2.0
  2  C    0.69850   1.20984   0.00000   2.0  2.0
  3  C   -0.69850   1.20984   0.00000   2.0  2.0
  4  C   -1.39700   0.00000   0.00000   2.0  2.0
  5  C   -0.69850  -1.20984   0.00000   2.0  2.0
  6  C    0.69850  -1.20984   0.00000   2.0  2.0
  7  H    2.48100   0.00000   0.00000   0.5  0.5
  8  H    1.24050   2.14861   0.00000   0.5  0.5
  9  H   -1.24050   2.14861   0.00000   0.5  0.5
 10  H   -2.48100   0.00000   0.00000   0.5  0.5
 11  H   -1.24050  -2.14861   0.00000   0.5  0.5
 12  H    1.24050  -2.14861   0.00000   0.5  0.5
Atoms.SpeciesAndCoordinates>

Atoms.UnitVectors.Unit      Ang
<Atoms.UnitVectors
  16.0   0.0   0.0
   0.0  16.0   0.0
   0.0   0.0  12.0
Atoms.UnitVectors>

scf.XcType                  GGA-PBE
scf.SpinPolarization        off
scf.EigenvalueSolver        Cluster
scf.Kgrid                   1 1 1
scf.energycutoff            220.0
scf.maxIter                 100
scf.criterion               1.0e-8
scf.ElectronicTemperature   300.0
scf.Mixing.Type             RMM-DIIS
scf.Init.Mixing.Weight      0.30
scf.Min.Mixing.Weight       0.001
scf.Max.Mixing.Weight       0.40
scf.Mixing.History          7
scf.Mixing.StartPulay       5

MD.Type                     Nomd

#
# Molecular orbitals
#
MO.fileout                  on         # write HOMO/LUMO cubes
num.HOMOs                   2          # HOMO and HOMO-1 (degenerate e1g pair)
num.LUMOs                   2          # LUMO and LUMO+1 (degenerate e2u pair)
MO.Nkpoint                  1          # must be 1 for a cluster calculation
<MO.kpoint
  0.0  0.0  0.0
MO.kpoint>
