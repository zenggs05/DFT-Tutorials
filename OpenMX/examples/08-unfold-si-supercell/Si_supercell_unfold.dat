# Perfect Si in the 8-atom conventional cubic cell, unfolded onto the fcc primitive cell.
# Sanity check: the unfolded spectral weight must reproduce the primitive-cell bands
# of ../08-band-cdia-si/Si_band.dat (same path L-G-X-W-K-G). OpenMX 4.0.

System.CurrrentDirectory    ./
System.Name                 si8_unfold
DATA.PATH                   /opt/openmx4.0/DFT_DATA19   # EDIT: dir containing PAO/ and VPS/
level.of.stdout             1
level.of.fileout            0

Species.Number              1
<Definition.of.Atomic.Species
  Si   Si7.0-s2p2d1   Si_PBE19
Definition.of.Atomic.Species>

Atoms.Number                8
Atoms.SpeciesAndCoordinates.Unit   FRAC
<Atoms.SpeciesAndCoordinates
  1  Si  0.00  0.00  0.00   2.0 2.0
  2  Si  0.00  0.50  0.50   2.0 2.0
  3  Si  0.50  0.00  0.50   2.0 2.0
  4  Si  0.50  0.50  0.00   2.0 2.0
  5  Si  0.25  0.25  0.25   2.0 2.0
  6  Si  0.25  0.75  0.75   2.0 2.0
  7  Si  0.75  0.25  0.75   2.0 2.0
  8  Si  0.75  0.75  0.25   2.0 2.0
Atoms.SpeciesAndCoordinates>

Atoms.UnitVectors.Unit      Ang
<Atoms.UnitVectors
  5.430  0.000  0.000
  0.000  5.430  0.000
  0.000  0.000  5.430
Atoms.UnitVectors>

scf.XcType                  GGA-PBE
scf.SpinPolarization        off
scf.ElectronicTemperature   300.0
scf.energycutoff            220.0
scf.maxIter                 100
scf.EigenvalueSolver        Band       # unfolding needs the Band (or Cluster) solver
scf.Kgrid                   6 6 6
scf.Mixing.Type             RMM-DIISK
scf.Init.Mixing.Weight      0.10
scf.Min.Mixing.Weight       0.001
scf.Max.Mixing.Weight       0.30
scf.Mixing.History          20
scf.Mixing.StartPulay       8
scf.criterion               1.0e-8

MD.Type                     Nomd

# ---------------- band unfolding ----------------
Unfolding.Electronic.Band   on
Unfolding.LowerBound        -13.0      # eV, relative to E_F
Unfolding.UpperBound          6.0      # eV, relative to E_F
# reference cell = fcc primitive cell of Si (same unit as Atoms.UnitVectors.Unit)
<Unfolding.ReferenceVectors
  0.000  2.715  2.715
  2.715  0.000  2.715
  2.715  2.715  0.000
Unfolding.ReferenceVectors>
# atoms 1-4 sit on the first fcc sublattice, atoms 5-8 on the second one
<Unfolding.Map
  1 1
  2 1
  3 1
  4 1
  5 2
  6 2
  7 2
  8 2
Unfolding.Map>
# path L-G-X-W-K-G, coordinates in units of the reciprocal vectors of the REFERENCE cell
Unfolding.Nkpoint           6
<Unfolding.kpoint
  L   0.500  0.500  0.500
  G   0.000  0.000  0.000
  X   0.000  0.500  0.500
  W   0.250  0.500  0.750
  K   0.375  0.375  0.750
  G   0.000  0.000  0.000
Unfolding.kpoint>
Unfolding.desired_totalnkpt 120
