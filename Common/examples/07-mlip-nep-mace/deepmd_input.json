{
  "_comment": "Minimal DeePMD-kit se_e2_a energy model. Train: dp --pt train deepmd_input.json ; freeze: dp --pt freeze",
  "model": {
    "type_map": ["Mo", "S"],
    "descriptor": {
      "type": "se_e2_a",
      "sel": "auto",
      "rcut_smth": 0.5,
      "rcut": 6.0,
      "neuron": [25, 50, 100],
      "axis_neuron": 16,
      "resnet_dt": false,
      "seed": 1
    },
    "fitting_net": {
      "neuron": [240, 240, 240],
      "resnet_dt": true,
      "seed": 1
    }
  },
  "learning_rate": {
    "type": "exp",
    "start_lr": 0.001,
    "stop_lr": 3.5e-8,
    "decay_steps": 5000
  },
  "loss": {
    "type": "ener",
    "start_pref_e": 0.02,
    "limit_pref_e": 1,
    "start_pref_f": 1000,
    "limit_pref_f": 1,
    "start_pref_v": 0,
    "limit_pref_v": 0
  },
  "training": {
    "training_data": {
      "systems": ["data/train"],
      "batch_size": "auto"
    },
    "validation_data": {
      "systems": ["data/valid"],
      "batch_size": 1
    },
    "numb_steps": 400000,
    "seed": 10,
    "disp_file": "lcurve.out",
    "disp_freq": 1000,
    "save_freq": 10000
  }
}
