# CP2K grid convergence template (works with CP2K 2023.x - 2026.2; nothing here changed in 2026)
# run_scan.sh rewrites the two @SET lines for every scan point.
@SET CUTOFF 400
@SET REL_CUTOFF 60

&GLOBAL
  PROJECT     scan
  RUN_TYPE    ENERGY
  PRINT_LEVEL MEDIUM            ! prints the "MULTIGRID INFO" block with the grid counts
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      NGRIDS     4              ! default
      CUTOFF     ${CUTOFF}      ! Ry, finest plane-wave grid
      REL_CUTOFF ${REL_CUTOFF}  ! Ry, decides on which grid each Gaussian product is mapped
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF   1.0E-7
      MAX_SCF   200
      ADDED_MOS 20
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD  BROYDEN_MIXING
        ALPHA   0.3
      &END MIXING
      &SMEAR ON
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 300
      &END SMEAR
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 5.431 5.431 5.431     ! Angstrom, 8-atom conventional Si cell
      PERIODIC XYZ
    &END CELL
    &COORD
      SCALED
      Si 0.00 0.00 0.00
      Si 0.50 0.50 0.00
      Si 0.50 0.00 0.50
      Si 0.00 0.50 0.50
      Si 0.25 0.25 0.25
      Si 0.75 0.75 0.25
      Si 0.75 0.25 0.75
      Si 0.25 0.75 0.75
    &END COORD
    &KIND Si
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q4
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
