# Chapter 9, example 2 (step 1 of 2): PBE single point for 32 H2O in a 9.8528 A box.
# Purpose: produce water32_pbe-RESTART.wfn as the initial guess for the PBE0 run
#          (water32_pbe0_admm_truncated.inp). Basis set and pseudopotentials are the SAME
#          hybrid-optimised UZH sets as in step 2, so the wavefunction can be re-used.
# Target versions: CP2K 2023.1 ... 2026.2
# Run:  mpirun -np 32 cp2k.psmp -i water32_pbe_step1.inp -o water32_pbe_step1.out

&GLOBAL
  PROJECT water32_pbe
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    &MGRID
      CUTOFF 400
      REL_CUTOFF 60
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 30
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE
      &END OT
      &OUTER_SCF
        EPS_SCF 1.0E-6
        MAX_SCF 10
      &END OUTER_SCF
      &PRINT
        ! write <PROJECT>-RESTART.wfn at the end of the SCF (default behaviour)
        &RESTART ON
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 9.8528 9.8528 9.8528
    &END CELL
    &TOPOLOGY
      COORD_FILE_NAME water32.xyz
      COORD_FILE_FORMAT XYZ
    &END TOPOLOGY
    &KIND O
      BASIS_SET DZVP-MOLOPT-PBE0-GTH-q6
      POTENTIAL GTH-PBE0-q6
    &END KIND
    &KIND H
      BASIS_SET DZVP-MOLOPT-PBE0-GTH-q1
      POTENTIAL GTH-PBE0-q1
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
