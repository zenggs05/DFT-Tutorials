# PDOS of rutile TiO2 (2x2x3 supercell, 72 atoms, Gamma point only)
# LEGACY syntax &DFT/&PRINT/&PDOS for CP2K <= 2026.1 (e.g. 2023.x - 2025.x).
# CP2K 2026.2 rejects this input with
#   "unknown subsection PDOS of section PRINT"
# -> for 2026.2 replace the &PDOS block by the &DOS block shown at the end.
# Legacy PDOS is not implemented for k-points, therefore a supercell is used.

&GLOBAL
  PROJECT     tio2_pdos
  RUN_TYPE    ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    &MGRID
      CUTOFF     500
      REL_CUTOFF 60
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF   1.0E-7
      MAX_SCF   200
      ADDED_MOS 100               ! virtual states come from the diagonalization
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD  BROYDEN_MIXING
        ALPHA   0.2
        NBUFFER 8
      &END MIXING
      &SMEAR ON
        METHOD FERMI_DIRAC        ! always give METHOD explicitly (default changed between versions)
        ELECTRONIC_TEMPERATURE [K] 300
      &END SMEAR
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &PRINT
      ! LEGACY PDOS section (<= 2026.1)
      &PDOS
        NLUMO 100                 ! unoccupied states written to the .pdos files (-1 = all)
        COMPONENTS F              ! s, p, d sums per kind
        &LDOS
          LIST 1                  ! PDOS projected on atom 1 only (a Ti atom)
        &END LDOS
      &END PDOS
    &END PRINT
  &END DFT
  &SUBSYS
    &CELL
      ! rutile, approximate experimental lattice parameters
      ABC 4.594 4.594 2.959
      MULTIPLE_UNIT_CELL 2 2 3
    &END CELL
    &TOPOLOGY
      MULTIPLE_UNIT_CELL 2 2 3    ! must match &CELL MULTIPLE_UNIT_CELL
    &END TOPOLOGY
    &COORD
      SCALED
      ! internal parameter u = 0.3048
      Ti  0.0000  0.0000  0.0000
      Ti  0.5000  0.5000  0.5000
      O   0.3048  0.3048  0.0000
      O   0.6952  0.6952  0.0000
      O   0.8048  0.1952  0.5000
      O   0.1952  0.8048  0.5000
    &END COORD
    &KIND Ti
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q12
      POTENTIAL GTH-PBE-q12
    &END KIND
    &KIND O
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q6
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

# ---------------------------------------------------------------------
# Equivalent block for CP2K >= 2026.2 (replace the whole &PDOS block):
#
#    &PRINT
#      &DOS
#        NLUMO   100
#        DELTA_E 0.0005
#        &PDOS
#          COMPONENTS F
#        &END PDOS
#        &LDOS
#          LIST 1
#        &END LDOS
#        &CURVE
#          ENERGY_UNIT EV
#          ENERGY_ZERO AUTO
#          &BROADEN
#            WIDTH [eV] 0.1
#          &END BROADEN
#        &END CURVE
#      &END DOS
#    &END PRINT
# ---------------------------------------------------------------------
