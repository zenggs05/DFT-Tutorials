# Chapter 7, example 2: GEO_OPT of H2O on a MgO(001) slab with the bottom layer fixed
# Target versions: CP2K 2023.1 ... 2026.2
# Slab: 2x2 (8.42 x 8.42 A), 3 layers, 48 atoms + 1 H2O; vacuum ~17 A along z.
# Atoms 1-16 in mgo001_h2o.xyz are the bottom MgO layer -> kept fixed.
# Run:  mpirun -np 32 cp2k.psmp -i slab_geo_opt_fixed.inp -o slab_geo_opt_fixed.out
@SET PROJ mgo_h2o_opt

&GLOBAL
  PROJECT ${PROJ}
  RUN_TYPE GEO_OPT
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    ! asymmetric slab (molecule on one side only): compensate the surface dipole
    SURFACE_DIPOLE_CORRECTION T
    SURF_DIP_DIR Z
    &MGRID
      CUTOFF 400
      REL_CUTOFF 50
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
      EXTRAPOLATION ASPC
      EXTRAPOLATION_ORDER 3
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 30
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE
      &END OT
      &OUTER_SCF
        EPS_SCF 1.0E-6
        MAX_SCF 15
      &END OUTER_SCF
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      ! adsorption needs dispersion; see chapter 8
      &VDW_POTENTIAL
        DISPERSION_FUNCTIONAL PAIR_POTENTIAL
        &PAIR_POTENTIAL
          TYPE DFTD3(BJ)
          PARAMETER_FILE_NAME dftd3.dat
          REFERENCE_FUNCTIONAL PBE
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 8.42 8.42 25.0
      PERIODIC XYZ
    &END CELL
    &TOPOLOGY
      COORD_FILE_NAME mgo001_h2o.xyz
      COORD_FILE_FORMAT XYZ
    &END TOPOLOGY
    &KIND Mg
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q10
      POTENTIAL GTH-PBE-q10
    &END KIND
    &KIND O
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q6
      POTENTIAL GTH-PBE-q6
    &END KIND
    &KIND H
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q1
      POTENTIAL GTH-PBE-q1
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

&MOTION
  &GEO_OPT
    OPTIMIZER BFGS
    MAX_ITER 300
    MAX_FORCE 4.5E-4
    &BFGS
      TRUST_RADIUS [angstrom] 0.20
    &END BFGS
  &END GEO_OPT
  &CONSTRAINT
    &FIXED_ATOMS
      ! 1..16 is CP2K's integer range syntax (atoms 1 to 16)
      COMPONENTS_TO_FIX XYZ
      LIST 1..16
    &END FIXED_ATOMS
  &END CONSTRAINT
  &PRINT
    &TRAJECTORY
      FORMAT XYZ
    &END TRAJECTORY
    &RESTART
      BACKUP_COPIES 1
    &END RESTART
  &END PRINT
&END MOTION
