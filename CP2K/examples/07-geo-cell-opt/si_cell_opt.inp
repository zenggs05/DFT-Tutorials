# Chapter 7, example 3: CELL_OPT of bulk Si (8-atom cubic cell, k-points)
# Target versions: CP2K 2026.2 syntax. The file also runs on 2023.x-2026.1 because it
# does NOT contain "TYPE DIRECT_CELL_OPT" (removed in 2026.2; it was the default before).
# Start lattice constant 5.55 A is deliberately too large (exp. 5.431 A).
# Run:  mpirun -np 16 cp2k.psmp -i si_cell_opt.inp -o si_cell_opt.out
@SET PROJ  si_cellopt
@SET ALAT  5.55

&GLOBAL
  PROJECT ${PROJ}
  RUN_TYPE CELL_OPT
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  ! analytical stress tensor is required for an efficient CELL_OPT
  STRESS_TENSOR ANALYTICAL
  &PRINT
    &STRESS_TENSOR ON
    &END STRESS_TENSOR
  &END PRINT
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    &MGRID
      ! stress needs a higher cutoff than energies (Pulay stress)
      CUTOFF 600
      REL_CUTOFF 60
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
    &END QS
    &KPOINTS
      SCHEME MONKHORST-PACK 4 4 4
    &END KPOINTS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-7
      MAX_SCF 100
      ! CP2K <= 2026.2: k-points require diagonalization (no OT)
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.3
        NBROYDEN 8
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC ${ALAT} ${ALAT} ${ALAT}
      SYMMETRY CUBIC
      ! fixed reference cell for the FFT grid: larger than any cell visited
      &CELL_REF
        ABC 5.70 5.70 5.70
      &END CELL_REF
    &END CELL
    &COORD
      SCALED
      Si 0.00 0.00 0.00
      Si 0.00 0.50 0.50
      Si 0.50 0.00 0.50
      Si 0.50 0.50 0.00
      Si 0.25 0.25 0.25
      Si 0.25 0.75 0.75
      Si 0.75 0.25 0.75
      Si 0.75 0.75 0.25
    &END COORD
    &KIND Si
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q4
      POTENTIAL GTH-PBE-q4
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

&MOTION
  &CELL_OPT
    ! CP2K <= 2026.1 accepted "TYPE DIRECT_CELL_OPT" here; 2026.2 aborts on it.
    OPTIMIZER BFGS
    MAX_ITER 100
    EXTERNAL_PRESSURE [bar] 1.01325
    PRESSURE_TOLERANCE [bar] 100.0
    KEEP_SYMMETRY T
    MAX_FORCE 4.5E-4
    RMS_FORCE 3.0E-4
    MAX_DR 3.0E-3
    RMS_DR 1.5E-3
  &END CELL_OPT
  &PRINT
    &TRAJECTORY
      FORMAT XYZ
    &END TRAJECTORY
    ! cell and stress files are only written at PRINT_LEVEL HIGH by default
    &CELL ON
    &END CELL
    &STRESS ON
    &END STRESS
    &RESTART
      BACKUP_COPIES 1
    &END RESTART
  &END PRINT
&END MOTION
