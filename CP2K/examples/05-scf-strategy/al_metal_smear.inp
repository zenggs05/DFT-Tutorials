# fcc Al (conventional 4-atom cell): metal -> diagonalization + mixing + smearing + ADDED_MOS
&GLOBAL
  PROJECT     al_fcc_smear
  RUN_TYPE    ENERGY_FORCE
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    &MGRID
      CUTOFF     300
      REL_CUTOFF 60
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
    &END QS
    &KPOINTS
      SCHEME MONKHORST-PACK 8 8 8   ! converge this for production (chapter 6)
    &END KPOINTS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF   1.0E-7
      MAX_SCF   100
      ADDED_MOS 10                  ! 6 occupied MOs per k-point -> 16 MOs in total
      &DIAGONALIZATION ON
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING ON
        METHOD  BROYDEN_MIXING
        ALPHA   0.2                 ! metals: smaller ALPHA is safer
        NBUFFER 8
      &END MIXING
      &SMEAR ON
        METHOD FERMI_DIRAC          ! always give METHOD explicitly (default changed in 2026.2)
        ELECTRONIC_TEMPERATURE [K] 500
      &END SMEAR
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 4.05 4.05 4.05            ! experimental lattice constant ~4.05 Angstrom
      PERIODIC XYZ
    &END CELL
    &COORD
      SCALED
      Al  0.0  0.0  0.0
      Al  0.0  0.5  0.5
      Al  0.5  0.0  0.5
      Al  0.5  0.5  0.0
    &END COORD
    &KIND Al
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q3
      POTENTIAL GTH-PBE-q3
    &END KIND
  &END SUBSYS
  &PRINT
    &FORCES ON
    &END FORCES
  &END PRINT
&END FORCE_EVAL
