# plumed.dat - well-tempered metadynamics on d(Na-Cl) driven by PLUMED 2.x
# Used by plumed_metad.inp (chapter 15).  Atom indices are 1-based as in CP2K:
# 1 = Na, 2 = Cl, water oxygens are atoms 3, 6, ..., 186.
# Units below: Angstrom, kJ/mol, fs (PLUMED defaults would be nm, kJ/mol, ps).
UNITS LENGTH=A ENERGY=kj/mol TIME=fs

d:  DISTANCE ATOMS=1,2
cn: COORDINATION GROUPA=1 GROUPB=3-186:3 R_0=3.0 NN=12 MM=24

# bias factor 6 at 300 K, Gaussian every 40 steps (20 fs), sigma 0.185 A
metad: METAD ARG=d SIGMA=0.185 HEIGHT=1.05 PACE=40 BIASFACTOR=6 TEMP=300 FILE=HILLS GRID_MIN=1.0 GRID_MAX=8.0 GRID_BIN=700

# harmonic upper wall at 5.6 A (box half-length is 6.21 A)
uwall: UPPER_WALLS ARG=d AT=5.6 KAPPA=500.0

PRINT ARG=d,cn,metad.bias,uwall.bias STRIDE=20 FILE=COLVAR
