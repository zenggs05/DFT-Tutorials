# QM/MM single point + forces: the same 125-water box as water_qmmm_tip3p.inp, but the
# MM force field and connectivity are read from an AMBER topology (prmtop) built with
# tleap (AmberTools). Chapter 16 of the CP2K tutorial.
#
# Prepare the topology first (AmberTools must be installed):
#   tleap -f tleap_water.in        ->  water125.prmtop  water125.inpcrd
#
# Notes
#   - with CONN_FILE_FORMAT AMBER, CP2K names the MM atomic kinds after the AMBER atom
#     types of the prmtop (TIP3P water: OW, HW); MM_KIND below uses these names.
#   - QM atoms are selected by their index in the prmtop / inpcrd (1-based).
#   - EI_SCALE14 / VDW_SCALE14 must be set to the AMBER values (CP2K defaults differ).
#   - the default AmberTools TIP3P residue is a rigid water: two O-H bonds plus an H-H
#     "bond" instead of an H-O-H angle term. CP2K treats them as ordinary harmonic bonds,
#     so the MM water differs from the flexible model of water_qmmm_tip3p.inp. Fine for
#     this single point; for MD use "set default FlexibleWater on" in tleap or add
#     constraints.
#   - TIP3P hydrogens carry no Lennard-Jones term. For production QM/MM consider giving
#     them a small LJ site (e.g. with ParmEd) to avoid over-polarisation near the QM atoms.
#
# Run:  mpirun -np 8 cp2k.psmp -i water_qmmm_amber.inp -o water_qmmm_amber.out

&GLOBAL
  PROJECT     water_qmmm_amber
  RUN_TYPE    ENERGY_FORCE
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD QMMM
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    CHARGE       0
    MULTIPLICITY 1
    &MGRID
      CUTOFF     400
      REL_CUTOFF 50
      COMMENSURATE                 ! mandatory for E_COUPL GAUSS / S-WAVE (run aborts otherwise)
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF   1.0E-6
      MAX_SCF   30
      &OT ON
        MINIMIZER      DIIS
        PRECONDITIONER FULL_ALL
      &END OT
      &OUTER_SCF ON
        EPS_SCF 1.0E-6
        MAX_SCF 10
      &END OUTER_SCF
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &MM
    &FORCEFIELD
      PARMTYPE       AMBER
      PARM_FILE_NAME water125.prmtop
      EI_SCALE14     0.8333333     ! AMBER 1-4 electrostatics scaling (1/1.2)
      VDW_SCALE14    0.5           ! AMBER 1-4 van der Waals scaling (1/2)
      &SPLINE
        RCUT_NB [angstrom] 7.5     ! must stay below half of the 15.54 A box
      &END SPLINE
    &END FORCEFIELD
    &POISSON
      &EWALD
        EWALD_TYPE SPME
        ALPHA      0.44
        GMAX       32
      &END EWALD
    &END POISSON
  &END MM
  &QMMM
    E_COUPL      GAUSS
    USE_GEEP_LIB 15
    &CELL
      ABC      10.0 10.0 10.0
      PERIODIC XYZ
    &END CELL
    &PERIODIC
      &MULTIPOLE ON
      &END MULTIPOLE
    &END PERIODIC
    &QM_KIND O
      MM_INDEX 1
    &END QM_KIND
    &QM_KIND H
      MM_INDEX 2 3
    &END QM_KIND
    &MM_KIND OW
      RADIUS 0.78
    &END MM_KIND
    &MM_KIND HW
      RADIUS 0.44
    &END MM_KIND
  &END QMMM
  &SUBSYS
    &CELL
      ABC      15.54 15.54 15.54
      PERIODIC XYZ
    &END CELL
    &TOPOLOGY
      CONN_FILE_FORMAT  AMBER
      CONN_FILE_NAME    water125.prmtop
      COORD_FILE_FORMAT CRD
      COORD_FILE_NAME   water125.inpcrd
    &END TOPOLOGY
    &KIND O
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q6
      POTENTIAL GTH-PBE-q6
    &END KIND
    &KIND H
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q1
      POTENTIAL GTH-PBE-q1
    &END KIND
  &END SUBSYS
  &PRINT
    &FORCES ON
    &END FORCES
  &END PRINT
&END FORCE_EVAL
