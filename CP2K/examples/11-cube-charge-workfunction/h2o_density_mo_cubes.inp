# Real-space output for an isolated H2O molecule:
#   electron density, Hartree potential, HOMO/LUMO cubes, ELF,
#   Mulliken / Lowdin / Hirshfeld charges and the dipole moment.
# Works with CP2K 2024.x - 2026.2 (no version-specific keywords used).

&GLOBAL
  PROJECT     h2o_cube
  RUN_TYPE    ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    &MGRID
      CUTOFF     400
      REL_CUTOFF 60
    &END MGRID
    &POISSON
      PERIODIC       NONE
      POISSON_SOLVER MT
    &END POISSON
    &QS
      EPS_DEFAULT 1.0E-12
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF   1.0E-7
      MAX_SCF   30
      &OT
        MINIMIZER      DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE
      &END OT
      &OUTER_SCF
        EPS_SCF 1.0E-7
        MAX_SCF 10
      &END OUTER_SCF
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &PRINT
      ! valence electron density (e/bohr^3); STRIDE 1 = full grid, needed for Bader
      &E_DENSITY_CUBE
        STRIDE 1 1 1
      &END E_DENSITY_CUBE
      ! Hartree potential of electrons + ions (hartree), electron-energy sign convention
      &V_HARTREE_CUBE
        STRIDE 2 2 2
      &END V_HARTREE_CUBE
      ! HOMO-1, HOMO, LUMO, LUMO+1 (with OT the LUMOs are computed after the SCF)
      &MO_CUBES
        NHOMO  2
        NLUMO  2
        STRIDE 2 2 2
      &END MO_CUBES
      ! electron localization function, values between 0 and 1
      &ELF_CUBE
        STRIDE 2 2 2
      &END ELF_CUBE
      &MULLIKEN ON
      &END MULLIKEN
      &LOWDIN ON
      &END LOWDIN
      &HIRSHFELD ON
      &END HIRSHFELD
      ! dipole moment; PERIODIC F because the cell is not periodic
      &MOMENTS ON
        PERIODIC F
      &END MOMENTS
    &END PRINT
  &END DFT
  &SUBSYS
    &CELL
      ABC 12.0 12.0 12.0
      PERIODIC NONE
    &END CELL
    &COORD
      O   0.000000   0.000000   0.117300
      H   0.000000   0.757000  -0.468600
      H   0.000000  -0.757000  -0.468600
    &END COORD
    &TOPOLOGY
      &CENTER_COORDINATES
      &END CENTER_COORDINATES
    &END TOPOLOGY
    &KIND H
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q1
      POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND O
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q6
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
