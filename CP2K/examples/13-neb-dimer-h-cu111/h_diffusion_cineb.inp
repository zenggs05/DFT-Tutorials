! h_diffusion_cineb.inp - CI-NEB for H hopping fcc -> hcp hollow on Cu(111)
! Chapter 13, step 2.  Target versions: CP2K 2023.1 ... 2026.2
! (PLOT_REL_ENERGY and the <PROJECT>-FINAL-1.xyz output need CP2K >= 2026.2)
!
! Needs initial_opt.xyz and final_opt.xyz from geo_opt_endpoint.inp (same atom order!).
! Total MPI ranks should be NUMBER_OF_REPLICA x NPROC_REP = 7 x 8 = 56:
!   mpirun -np 56 cp2k.psmp -i h_diffusion_cineb.inp -o h_diffusion_cineb.out
! On a 32-core node use e.g. -np 28 together with -E NPROC_REP=4.
!
! Restart an unfinished band: add
!   &EXT_RESTART
!     RESTART_FILE_NAME h_cu111_neb-1.restart
!   &END EXT_RESTART

@SET COORD ${INIT-initial_opt.xyz}

&GLOBAL
  PROJECT h_cu111_neb
  RUN_TYPE BAND
  PRINT_LEVEL LOW
&END GLOBAL

@INCLUDE 'cu111_h_force_eval.inc'

&MOTION
  &BAND
    BAND_TYPE CI-NEB
    ! includes both end points; missing images are generated by bisection
    ! (linear interpolation between the given replicas)
    NUMBER_OF_REPLICA 7
    NPROC_REP ${NPROC_REP-8}
    ! spring constant in atomic units (default 0.02)
    K_SPRING 0.05
    ! slab with fixed atoms in a periodic cell: never rotate/align the frames
    ALIGN_FRAMES F
    ROTATE_FRAMES F
    &CI_NEB
      ! plain IT-NEB steps before the highest image starts climbing
      NSTEPS_IT 10
    &END CI_NEB
    &OPTIMIZE_BAND
      OPT_TYPE DIIS
      &DIIS
        MAX_STEPS 300
        N_DIIS 5
      &END DIIS
    &END OPTIMIZE_BAND
    &CONVERGENCE_CONTROL
      ! forces in hartree/bohr (1.0E-3 Ha/bohr ~ 0.05 eV/A); displacements in bohr
      MAX_FORCE 1.0E-3
      RMS_FORCE 5.0E-4
      MAX_DR 5.0E-3
      RMS_DR 2.5E-3
    &END CONVERGENCE_CONTROL
    &REPLICA
      COORD_FILE_NAME ${INIT-initial_opt.xyz}
    &END REPLICA
    ! optional: add an intermediate guess (e.g. ts_guess.xyz) as a third &REPLICA
    ! block between the two end points to bias the initial path
    &REPLICA
      COORD_FILE_NAME ${FINAL-final_opt.xyz}
    &END REPLICA
    &PROGRAM_RUN_INFO ON
      INITIAL_CONFIGURATION_INFO
      ! CP2K >= 2026.2 only: ASCII energy profile in the main output
      ! PLOT_REL_ENERGY T
    &END PROGRAM_RUN_INFO
    &CONVERGENCE_INFO ON
    &END CONVERGENCE_INFO
  &END BAND
  &CONSTRAINT
    &FIXED_ATOMS
      LIST 1..9
    &END FIXED_ATOMS
  &END CONSTRAINT
  &PRINT
    &TRAJECTORY
      FORMAT XYZ
    &END TRAJECTORY
    &RESTART
      BACKUP_COPIES 0
    &END RESTART
  &END PRINT
&END MOTION
