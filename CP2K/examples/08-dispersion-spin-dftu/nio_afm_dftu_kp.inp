# Chapter 8, example 3a: antiferromagnetic (AFM-II) NiO with PBE+U and k-points
# Target version: CP2K >= 2026.2 (DFT+U with k-points, Mulliken methods, PR #4855).
# For CP2K <= 2026.1 use nio_afm_dftu_gamma.inp (Gamma-only 64-atom supercell).
# Cell: rhombohedral AFM-II cell, 2 NiO units, built from a = 4.17 A (exp. rocksalt).
#   ABC = a*sqrt(3/2) = 5.1072 A, angles 33.5573 deg; Ni1 (spin up) and Ni2 (spin down)
#   sit on alternating (111) planes.
@SET PROJ  nio_afm_kp
@SET UEFF  6.0

&GLOBAL
  PROJECT ${PROJ}
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    UKS
    ! AFM: equal numbers of up and down electrons -> 2S+1 = 1
    MULTIPLICITY 1
    PLUS_U_METHOD MULLIKEN
    &MGRID
      CUTOFF 600
      REL_CUTOFF 60
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
    &END QS
    &KPOINTS
      SCHEME MONKHORST-PACK 4 4 4
    &END KPOINTS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 300
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.1
        NBROYDEN 10
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &PRINT
      ! occupation matrices of the +U shells (default print level is HIGH)
      &PLUS_U ON
      &END PLUS_U
      &MULLIKEN ON
      &END MULLIKEN
    &END PRINT
  &END DFT
  &SUBSYS
    &CELL
      ABC 5.107186 5.107186 5.107186
      ALPHA_BETA_GAMMA 33.557310 33.557310 33.557310
    &END CELL
    &COORD
      SCALED
      Ni1 0.00 0.00 0.00
      Ni2 0.50 0.50 0.50
      O   0.25 0.25 0.25
      O   0.75 0.75 0.75
    &END COORD
    &KIND Ni1
      ELEMENT Ni
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q18
      POTENTIAL GTH-PBE-q18
      ! Ni2+ is d8: +2 -> one extra alpha and one less beta electron in the guess
      MAGNETIZATION 2.0
      &DFT_PLUS_U
        L 2
        ! the default unit of U_MINUS_J is hartree: always write [eV]
        U_MINUS_J [eV] ${UEFF}
      &END DFT_PLUS_U
    &END KIND
    &KIND Ni2
      ELEMENT Ni
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q18
      POTENTIAL GTH-PBE-q18
      MAGNETIZATION -2.0
      &DFT_PLUS_U
        L 2
        U_MINUS_J [eV] ${UEFF}
      &END DFT_PLUS_U
    &END KIND
    &KIND O
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q6
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
