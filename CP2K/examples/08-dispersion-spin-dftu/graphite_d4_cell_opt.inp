# Chapter 8, example 4: CELL_OPT of AB (Bernal) graphite with PBE-D4
# Target versions: CP2K 2026.2 syntax; also valid for 2023.x-2026.1 (no CELL_OPT TYPE line).
# DFT-D4 needs a CP2K build linked against libdftd4 ("libdftd4" in the cp2kflags printed
# by "cp2k.psmp -v"). Without it, set VDW to D3BJ.
# Start: a = 2.464 A, c = 7.20 A (exp. c = 6.711 A, interlayer distance 3.355 A).
@SET PROJ  graphite_cellopt
@SET VDW   D4
@SET A0    2.464
@SET C0    7.20

&GLOBAL
  PROJECT ${PROJ}_${VDW}
  RUN_TYPE CELL_OPT
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  STRESS_TENSOR ANALYTICAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    &MGRID
      CUTOFF 600
      REL_CUTOFF 60
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
    &END QS
    &KPOINTS
      SCHEME MONKHORST-PACK 12 12 4
    &END KPOINTS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-7
      MAX_SCF 150
      ! graphite is a semimetal: smearing + enough empty states
      ADDED_MOS 20
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.2
        NBROYDEN 8
      &END MIXING
      &SMEAR ON
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 300
      &END SMEAR
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        DISPERSION_FUNCTIONAL PAIR_POTENTIAL
        &PAIR_POTENTIAL
@IF ${VDW} == D4
          TYPE DFTD4
          ! D4 takes its parameters from libdftd4; PARAMETER_FILE_NAME is not used
          REFERENCE_FUNCTIONAL PBE
@ENDIF
@IF ${VDW} == D3BJ
          TYPE DFTD3(BJ)
          PARAMETER_FILE_NAME dftd3.dat
          REFERENCE_FUNCTIONAL PBE
@ENDIF
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC ${A0} ${A0} ${C0}
      ALPHA_BETA_GAMMA 90.0 90.0 120.0
    &END CELL
    &COORD
      SCALED
      C 0.000000 0.000000 0.250000
      C 0.000000 0.000000 0.750000
      C 0.333333 0.666667 0.250000
      C 0.666667 0.333333 0.750000
    &END COORD
    &KIND C
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q4
      POTENTIAL GTH-PBE-q4
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

&MOTION
  &CELL_OPT
    OPTIMIZER BFGS
    MAX_ITER 100
    EXTERNAL_PRESSURE [bar] 1.01325
    PRESSURE_TOLERANCE [bar] 50.0
    KEEP_ANGLES T
  &END CELL_OPT
  &PRINT
    &CELL ON
    &END CELL
    &TRAJECTORY
      FORMAT XYZ
    &END TRAJECTORY
  &END PRINT
&END MOTION
