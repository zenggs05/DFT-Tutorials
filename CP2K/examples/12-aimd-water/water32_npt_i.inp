# Step 3b: isotropic NPT (NPT_I) at 1 atm and 300 K, started from the NVT state
#   - analytical stress tensor is mandatory for constant-pressure MD
#   - CUTOFF raised to 600 Ry to reduce the Pulay stress
#   - CELL_REF fixes the real-space grid on a slightly larger reference cell,
#     so that the effective cutoff does not drop when the box expands
#   - RESTART_CELL F is required: otherwise the &CELL section of the NVT restart
#     file (which has no CELL_REF) silently replaces the whole &CELL below
# Expect large pressure fluctuations (several kbar) for only 96 atoms.

&GLOBAL
  PROJECT     water32_npt
  RUN_TYPE    MD
  PRINT_LEVEL LOW
&END GLOBAL

&EXT_RESTART
  RESTART_FILE_NAME  water32_nvt-1.restart
  RESTART_POS        T
  RESTART_VEL        T
  RESTART_THERMOSTAT F            ! new thermostat settings below
  RESTART_COUNTERS   F
  RESTART_CELL       F            ! keep the &CELL of THIS input: the NVT restart
                                  ! has no CELL_REF and would replace the whole &CELL
&END EXT_RESTART

&MOTION
  &MD
    ENSEMBLE    NPT_I
    STEPS       6000              ! 3 ps
    TIMESTEP    0.5
    TEMPERATURE 300.0
    &THERMOSTAT
      TYPE   CSVR
      REGION GLOBAL
      &CSVR
        TIMECON 100.0
      &END CSVR
    &END THERMOSTAT
    &BAROSTAT
      PRESSURE [bar] 1.01325
      TIMECON  [fs]  300.0
    &END BAROSTAT
  &END MD
  &PRINT
    &TRAJECTORY
      &EACH
        MD 10
      &END EACH
    &END TRAJECTORY
    &CELL ON                      ! water32_npt-1.cell: step, time, cell vectors, volume
      &EACH
        MD 10                     ! same stride as TRAJECTORY, needed by reftraj_npt.inp
      &END EACH
    &END CELL
    &STRESS ON
      &EACH
        MD 10
      &END EACH
    &END STRESS
    &RESTART
      BACKUP_COPIES 2
      &EACH
        MD 20
      &END EACH
    &END RESTART
  &END PRINT
&END MOTION

&FORCE_EVAL
  METHOD QUICKSTEP
  STRESS_TENSOR ANALYTICAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    WFN_RESTART_FILE_NAME water32_nvt-RESTART.wfn
    &MGRID
      CUTOFF     600
      REL_CUTOFF 60
    &END MGRID
    &QS
      EPS_DEFAULT         1.0E-12
      EXTRAPOLATION       ASPC
      EXTRAPOLATION_ORDER 3
    &END QS
    &SCF
      SCF_GUESS RESTART
      EPS_SCF   1.0E-6
      MAX_SCF   30
      &OT
        MINIMIZER      DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE
      &END OT
      &OUTER_SCF
        EPS_SCF 1.0E-6
        MAX_SCF 10
      &END OUTER_SCF
      &PRINT
        &RESTART
          BACKUP_COPIES 0
          &EACH
            MD 10
          &END EACH
        &END RESTART
        &RESTART_HISTORY OFF
        &END RESTART_HISTORY
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          TYPE DFTD3(BJ)
          PARAMETER_FILE_NAME dftd3.dat
          REFERENCE_FUNCTIONAL PBE
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 9.8654 9.8654 9.8654
      PERIODIC XYZ
      &CELL_REF
        ABC 10.4 10.4 10.4
      &END CELL_REF
    &END CELL
    &TOPOLOGY
      COORD_FILE_NAME   water32.xyz
      COORD_FILE_FORMAT XYZ
    &END TOPOLOGY
    &KIND H
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q1
      POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND O
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q6
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
