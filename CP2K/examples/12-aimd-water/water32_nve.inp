# Step 3a: NVE run started from the equilibrated NVT state (water32_nvt-1.restart)
#   - checks energy conservation (Cons Qty column of water32_nve-1.ener)
#   - writes velocities and the cell dipole every 2 steps (1 fs) for VDOS / IR spectra
# The thermostat of the NVT restart is NOT restarted (NVE has no thermostat),
# and the step counter starts again from 0.

&GLOBAL
  PROJECT     water32_nve
  RUN_TYPE    MD
  PRINT_LEVEL LOW
&END GLOBAL

&EXT_RESTART
  RESTART_FILE_NAME  water32_nvt-1.restart
  RESTART_POS        T
  RESTART_VEL        T
  RESTART_THERMOSTAT F
  RESTART_COUNTERS   F
&END EXT_RESTART

&MOTION
  &MD
    ENSEMBLE    NVE
    STEPS       4000              ! 2 ps
    TIMESTEP    0.5
    TEMPERATURE 300.0             ! not used when velocities are restarted
  &END MD
  &PRINT
    &TRAJECTORY
      &EACH
        MD 2
      &END EACH
    &END TRAJECTORY
    &VELOCITIES ON
      &EACH
        MD 2
      &END EACH
    &END VELOCITIES
    &RESTART
      BACKUP_COPIES 2
      &EACH
        MD 20
      &END EACH
    &END RESTART
  &END PRINT
&END MOTION

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    WFN_RESTART_FILE_NAME water32_nvt-RESTART.wfn
    &MGRID
      CUTOFF     400
      REL_CUTOFF 60
    &END MGRID
    &QS
      EPS_DEFAULT         1.0E-12
      EXTRAPOLATION       ASPC
      EXTRAPOLATION_ORDER 3
    &END QS
    &SCF
      SCF_GUESS RESTART
      EPS_SCF   1.0E-6
      MAX_SCF   30
      &OT
        MINIMIZER      DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE
      &END OT
      &OUTER_SCF
        EPS_SCF 1.0E-6
        MAX_SCF 10
      &END OUTER_SCF
      &PRINT
        &RESTART
          BACKUP_COPIES 0
          &EACH
            MD 10
          &END EACH
        &END RESTART
        &RESTART_HISTORY OFF
        &END RESTART_HISTORY
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          TYPE DFTD3(BJ)
          PARAMETER_FILE_NAME dftd3.dat
          REFERENCE_FUNCTIONAL PBE
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC
    &PRINT
      ! total dipole of the periodic cell (Berry phase), appended every 2 MD steps
      &MOMENTS ON
        PERIODIC T
        FILENAME =water32_nve_dipole.dat
        &EACH
          MD 2
        &END EACH
      &END MOMENTS
    &END PRINT
  &END DFT
  &SUBSYS
    &CELL
      ABC 9.8654 9.8654 9.8654
      PERIODIC XYZ
    &END CELL
    &TOPOLOGY
      COORD_FILE_NAME   water32.xyz
      COORD_FILE_FORMAT XYZ
    &END TOPOLOGY
    &KIND H
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q1
      POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND O
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q6
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
