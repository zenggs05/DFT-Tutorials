# Step 4: re-evaluate selected frames of the production trajectory (REFTRAJ)
#   with a different electronic-structure setting (here: TZV2P basis, 500 Ry),
#   e.g. to label structures for a machine-learning potential or to check
#   the sensitivity of energies/forces to the basis set.
# Syntax for CP2K >= 2026.2:   EVAL ENERGY_FORCES
#   (EVAL exists since at least 2024.1; the old logical keywords
#    EVAL_ENERGY_FORCES / EVAL_FORCES were removed in 2026.2.)
# Frames: 1, 101, 201, ..., 901 of water32_prod-pos-1.xyz (10 frames).
# LAST_SNAPSHOT must equal FIRST_SNAPSHOT + STRIDE * (number of strides).

&GLOBAL
  PROJECT     water32_reftraj
  RUN_TYPE    MD
  PRINT_LEVEL LOW
&END GLOBAL

&MOTION
  &MD
    ENSEMBLE REFTRAJ
    STEPS    10                   ! ignored: reset to LAST-FIRST+1 = 901, every STRIDE-th -> 10 frames
    &REFTRAJ
      TRAJ_FILE_NAME water32_prod-pos-1.xyz
      FIRST_SNAPSHOT 1
      LAST_SNAPSHOT  901
      STRIDE         100
      EVAL           ENERGY_FORCES
    &END REFTRAJ
  &END MD
  &PRINT
    &FORCES ON
      &EACH
        MD 1
      &END EACH
    &END FORCES
  &END PRINT
&END MOTION

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    &MGRID
      CUTOFF     500
      REL_CUTOFF 60
    &END MGRID
    &QS
      EPS_DEFAULT   1.0E-12
      EXTRAPOLATION USE_PREV_WF   ! frames are 500 fs apart: only reuse the previous WFN
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF   1.0E-7
      MAX_SCF   30
      &OT
        MINIMIZER      DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE
      &END OT
      &OUTER_SCF
        EPS_SCF 1.0E-7
        MAX_SCF 10
      &END OUTER_SCF
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          TYPE DFTD3(BJ)
          PARAMETER_FILE_NAME dftd3.dat
          REFERENCE_FUNCTIONAL PBE
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ! constant cell; for NPT trajectories use VARIABLE_VOLUME + CELL_FILE_NAME,
      ! or an EXTXYZ trajectory with Lattice="..." (read since 2026.2)
      ABC 9.8654 9.8654 9.8654
      PERIODIC XYZ
    &END CELL
    &TOPOLOGY
      COORD_FILE_NAME   water32.xyz
      COORD_FILE_FORMAT XYZ
    &END TOPOLOGY
    &KIND H
      BASIS_SET TZV2P-MOLOPT-PBE-GTH-q1
      POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND O
      BASIS_SET TZV2P-MOLOPT-PBE-GTH-q6
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
