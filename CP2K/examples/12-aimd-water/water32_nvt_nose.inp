# Step 2 (alternative): NVT production with a Nose-Hoover chain thermostat
#   instead of CSVR, continued from the CSVR equilibration (water32_nvt-1.restart).
#   - the thermostat TYPE changes, so the old thermostat state is NOT restarted
#   - REGION GLOBAL: one chain for the whole box (least perturbation of dynamics)
#     REGION MASSIVE (one chain per degree of freedom) equilibrates fastest but
#     destroys dynamical properties (diffusion, VACF, IR): do not use it for those.
# Compare T distribution and RDF with md_restart.inp (CSVR): both are canonical.

&GLOBAL
  PROJECT     water32_nose
  RUN_TYPE    MD
  PRINT_LEVEL LOW
&END GLOBAL

&EXT_RESTART
  RESTART_FILE_NAME  water32_nvt-1.restart
  RESTART_POS        T
  RESTART_VEL        T
  RESTART_THERMOSTAT F            ! CSVR state cannot be reused by a Nose chain
  RESTART_COUNTERS   F
&END EXT_RESTART

&MOTION
  &MD
    ENSEMBLE    NVT
    STEPS       10000             ! 5 ps
    TIMESTEP    0.5
    TEMPERATURE 300.0
    &THERMOSTAT
      TYPE   NOSE
      REGION GLOBAL
      &NOSE
        LENGTH  3                 ! chain length (default 3)
        YOSHIDA 3                 ! Suzuki-Yoshida integrator order (default 3)
        MTS     2                 ! multiple time steps for the chain (default 2)
        TIMECON 200.0             ! fs (default 1000 fs); smaller = stronger coupling
      &END NOSE
    &END THERMOSTAT
  &END MD
  &PRINT
    &TRAJECTORY
      &EACH
        MD 10
      &END EACH
    &END TRAJECTORY
    &VELOCITIES ON
      &EACH
        MD 10
      &END EACH
    &END VELOCITIES
    &RESTART
      BACKUP_COPIES 2
      &EACH
        MD 20
      &END EACH
    &END RESTART
    &RESTART_HISTORY
      &EACH
        MD 2000
      &END EACH
    &END RESTART_HISTORY
  &END PRINT
&END MOTION

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    WFN_RESTART_FILE_NAME water32_nvt-RESTART.wfn
    &MGRID
      CUTOFF     400
      REL_CUTOFF 60
    &END MGRID
    &QS
      EPS_DEFAULT         1.0E-12
      EXTRAPOLATION       ASPC
      EXTRAPOLATION_ORDER 3
    &END QS
    &SCF
      SCF_GUESS RESTART
      EPS_SCF   1.0E-6
      MAX_SCF   30
      &OT
        MINIMIZER      DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE
      &END OT
      &OUTER_SCF
        EPS_SCF 1.0E-6
        MAX_SCF 10
      &END OUTER_SCF
      &PRINT
        &RESTART
          BACKUP_COPIES 0
          &EACH
            MD 10
          &END EACH
        &END RESTART
        &RESTART_HISTORY OFF
        &END RESTART_HISTORY
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          TYPE DFTD3(BJ)
          PARAMETER_FILE_NAME dftd3.dat
          REFERENCE_FUNCTIONAL PBE
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 9.8654 9.8654 9.8654
      PERIODIC XYZ
    &END CELL
    &TOPOLOGY
      ! only used to define the atoms; positions are taken from the restart file
      COORD_FILE_NAME   water32.xyz
      COORD_FILE_FORMAT XYZ
    &END TOPOLOGY
    &KIND H
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q1
      POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND O
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q6
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
