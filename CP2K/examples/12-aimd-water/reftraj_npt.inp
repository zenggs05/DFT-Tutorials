# Step 4b: REFTRAJ re-evaluation of an NPT trajectory (variable cell)
#   The cell of every frame is read from water32_npt-1.cell (VARIABLE_VOLUME T).
#   This works only if TRAJECTORY and CELL were written with the SAME stride
#   (both MD 10 in water32_npt_i.inp); the step numbers are checked frame by frame.
#   Alternative (CP2K >= 2026.2): write the NPT trajectory with
#     &TRAJECTORY FORMAT EXTXYZ (cell in the Lattice="..." comment line)
#   and drop CELL_FILE_NAME: the cell is then read from the trajectory itself.
# Frames: snapshot 101 (= MD step 1000, after 0.5 ps of NPT) to 601, every 50
#   -> 11 frames. LAST_SNAPSHOT = FIRST_SNAPSHOT + STRIDE * (number of strides).
# Same electronic structure as the NPT run (600 Ry, CELL_REF) so that the
# energies can be compared directly with the Pot. column of water32_npt-1.ener.

&GLOBAL
  PROJECT     water32_reftraj_npt
  RUN_TYPE    MD
  PRINT_LEVEL LOW
&END GLOBAL

&MOTION
  &MD
    ENSEMBLE REFTRAJ
    STEPS    11                   ! ignored: reset to LAST-FIRST+1 = 501, every STRIDE-th -> 11 frames
    &REFTRAJ
      TRAJ_FILE_NAME  water32_npt-pos-1.xyz
      CELL_FILE_NAME  water32_npt-1.cell
      VARIABLE_VOLUME T
      FIRST_SNAPSHOT  101
      LAST_SNAPSHOT   601
      STRIDE          50
      EVAL            ENERGY_FORCES
    &END REFTRAJ
  &END MD
  &PRINT
    &FORCES ON
      &EACH
        MD 1
      &END EACH
    &END FORCES
    &CELL ON
      &EACH
        MD 1
      &END EACH
    &END CELL
  &END PRINT
&END MOTION

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    &MGRID
      CUTOFF     600
      REL_CUTOFF 60
    &END MGRID
    &QS
      EPS_DEFAULT         1.0E-12
      EXTRAPOLATION       USE_PREV_WF ! frames are 250 fs apart: no ASPC history
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF   1.0E-6
      MAX_SCF   30
      &OT
        MINIMIZER      DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE
      &END OT
      &OUTER_SCF
        EPS_SCF 1.0E-6
        MAX_SCF 10
      &END OUTER_SCF
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          TYPE DFTD3(BJ)
          PARAMETER_FILE_NAME dftd3.dat
          REFERENCE_FUNCTIONAL PBE
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ! only the initial cell; replaced frame by frame by water32_npt-1.cell
      ABC 9.8654 9.8654 9.8654
      PERIODIC XYZ
      &CELL_REF
        ABC 10.4 10.4 10.4
      &END CELL_REF
    &END CELL
    &TOPOLOGY
      COORD_FILE_NAME   water32.xyz
      COORD_FILE_FORMAT XYZ
    &END TOPOLOGY
    &KIND H
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q1
      POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND O
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q6
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
