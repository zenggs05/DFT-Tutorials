# Step 2: continue the NVT run (production) from the restart files of step 1
#   positions, velocities, thermostat state and step counter: water32_nvt-1.restart
#   wavefunction:                                            water32_nvt-RESTART.wfn
# The thermostat is made weaker (TIMECON 200 fs) for production sampling.
# A new PROJECT name keeps the output of both stages in separate files.

&GLOBAL
  PROJECT     water32_prod
  RUN_TYPE    MD
  PRINT_LEVEL LOW
&END GLOBAL

&EXT_RESTART
  RESTART_FILE_NAME water32_nvt-1.restart
  ! defaults restart everything that is meaningful: positions, velocities,
  ! thermostat, counters. Written out here for clarity.
  RESTART_POS        T
  RESTART_VEL        T
  RESTART_THERMOSTAT T
  RESTART_COUNTERS   T
&END EXT_RESTART

&MOTION
  &MD
    ENSEMBLE    NVT
    STEPS       10000             ! 10000 MORE steps (5 ps) after the restart point
    ! MAX_STEPS (cap on the TOTAL step counter) is deliberately not set: the step
    ! that reaches MAX_STEPS is treated as a stop, and without FORCE_LAST its
    ! output and restart file are not written (see chapter 12, section 6).
    TIMESTEP    0.5
    TEMPERATURE 300.0
    &THERMOSTAT
      TYPE   CSVR
      REGION GLOBAL
      &CSVR
        TIMECON 200.0             ! fs, gentle coupling for production
      &END CSVR
    &END THERMOSTAT
  &END MD
  &PRINT
    &TRAJECTORY
      &EACH
        MD 10
      &END EACH
    &END TRAJECTORY
    &VELOCITIES ON
      &EACH
        MD 10
      &END EACH
    &END VELOCITIES
    &FORCES ON
      &EACH
        MD 10
      &END EACH
    &END FORCES
    &RESTART
      BACKUP_COPIES 2
      &EACH
        MD 20
      &END EACH
    &END RESTART
    &RESTART_HISTORY
      &EACH
        MD 2000
      &END EACH
    &END RESTART_HISTORY
  &END PRINT
&END MOTION

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    WFN_RESTART_FILE_NAME water32_nvt-RESTART.wfn
    &MGRID
      CUTOFF     400
      REL_CUTOFF 60
    &END MGRID
    &QS
      EPS_DEFAULT         1.0E-12
      EXTRAPOLATION       ASPC
      EXTRAPOLATION_ORDER 3
    &END QS
    &SCF
      SCF_GUESS RESTART
      EPS_SCF   1.0E-6
      MAX_SCF   30
      &OT
        MINIMIZER      DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE
      &END OT
      &OUTER_SCF
        EPS_SCF 1.0E-6
        MAX_SCF 10
      &END OUTER_SCF
      &PRINT
        &RESTART
          BACKUP_COPIES 0
          &EACH
            MD 10
          &END EACH
        &END RESTART
        &RESTART_HISTORY OFF
        &END RESTART_HISTORY
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          TYPE DFTD3(BJ)
          PARAMETER_FILE_NAME dftd3.dat
          REFERENCE_FUNCTIONAL PBE
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 9.8654 9.8654 9.8654
      PERIODIC XYZ
    &END CELL
    &TOPOLOGY
      ! only used to define the atoms; positions are taken from the restart file
      COORD_FILE_NAME   water32.xyz
      COORD_FILE_FORMAT XYZ
    &END TOPOLOGY
    &KIND H
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q1
      POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND O
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q6
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
