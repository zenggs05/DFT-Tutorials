# Continue the Si cell optimisation of si_cellopt_2026_2.inp (chapter 18, section 8.2).
# Requires the files written by the first run in the same directory:
#   si8_cellopt-1.restart       motion restart (positions, cell, step counter)
#   si8_cellopt-RESTART.kp      k-point wavefunction restart (NOT interchangeable with .wfn)
# A new PROJECT name is used so that the first run's output files are not overwritten.
# The tighter PRESSURE_TOLERANCE shows that settings may be changed when continuing.
#
#   cp2k.psmp -c si_cellopt_restart.inp
#   mpirun -np 8 cp2k.psmp -i si_cellopt_restart.inp -o si_cellopt_restart.out
#
# The input itself has no version-specific keywords, but it continues a 2026.2 run
# (si_cellopt_2026_2.inp), so use the same CP2K 2026.2 binary for both runs.

&GLOBAL
  PROJECT     si8_cellopt_r2
  RUN_TYPE    CELL_OPT
  PRINT_LEVEL MEDIUM
&END GLOBAL

&EXT_RESTART
  RESTART_FILE_NAME si8_cellopt-1.restart
  RESTART_DEFAULT   F                ! restore only what is switched on below
  RESTART_POS       T                ! atomic positions
  RESTART_CELL      T                ! cell vectors
  RESTART_COUNTERS  T                ! continue the step numbering (set F to start at 0)
&END EXT_RESTART

&MOTION
  &CELL_OPT
    OPTIMIZER          BFGS
    KEEP_ANGLES        T
    EXTERNAL_PRESSURE  [bar] 1.0
    PRESSURE_TOLERANCE [bar] 50.0
    MAX_ITER           100
  &END CELL_OPT
  &PRINT
    &RESTART ON
      BACKUP_COPIES 2
    &END RESTART
    &RESTART_HISTORY ON
      &EACH
        CELL_OPT 10
      &END EACH
    &END RESTART_HISTORY
  &END PRINT
&END MOTION

&FORCE_EVAL
  METHOD QUICKSTEP
  STRESS_TENSOR ANALYTICAL
  &DFT
    BASIS_SET_FILE_NAME   BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME   POTENTIAL_UZH
    WFN_RESTART_FILE_NAME si8_cellopt-RESTART.kp
    &MGRID
      CUTOFF     600
      REL_CUTOFF 60
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
    &END QS
    &KPOINTS
      SCHEME MONKHORST-PACK 4 4 4
    &END KPOINTS
    &SCF
      SCF_GUESS RESTART              ! falls back to ATOMIC (with a warning) if the .kp file is missing
      EPS_SCF   1.0E-7
      MAX_SCF   80
      ADDED_MOS 8
      &DIAGONALIZATION ON
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA  0.3
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    # &CELL and &COORD are still required by the parser; RESTART_CELL/RESTART_POS
    # replace these values with the ones stored in si8_cellopt-1.restart.
    &CELL
      ABC 5.40 5.40 5.40
      PERIODIC XYZ
    &END CELL
    &COORD
      SCALED
      Si  0.00  0.00  0.00
      Si  0.00  0.50  0.50
      Si  0.50  0.00  0.50
      Si  0.50  0.50  0.00
      Si  0.25  0.25  0.25
      Si  0.25  0.75  0.75
      Si  0.75  0.25  0.75
      Si  0.75  0.75  0.25
    &END COORD
    &KIND Si
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q4
      POTENTIAL GTH-PBE-q4
    &END KIND
  &END SUBSYS
  &PRINT
    &STRESS_TENSOR ON
    &END STRESS_TENSOR
  &END PRINT
&END FORCE_EVAL
