# Si (8-atom cubic cell) cell optimisation written for CP2K 2025.x and older.
# Chapter 18 of the CP2K tutorial: this file runs on <= 2026.1 but NOT on 2026.2.
# Compare with si_cellopt_2026_2.inp:   diff legacy_si_cellopt_2025.inp si_cellopt_2026_2.inp
# Let check_migration.sh find the outdated lines:   bash check_migration.sh legacy_si_cellopt_2025.inp

&GLOBAL
  PROJECT     si8_cellopt
  RUN_TYPE    CELL_OPT
  PRINT_LEVEL MEDIUM
&END GLOBAL

&MOTION
  &CELL_OPT
    TYPE               DIRECT_CELL_OPT
    OPTIMIZER          BFGS
    KEEP_ANGLES        T
    EXTERNAL_PRESSURE  [bar] 1.0
    PRESSURE_TOLERANCE [bar] 100.0
    MAX_ITER           100
  &END CELL_OPT
&END MOTION

&FORCE_EVAL
  METHOD QUICKSTEP
  STRESS_TENSOR ANALYTICAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    &MGRID
      CUTOFF     600
      REL_CUTOFF 60
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
    &END QS
    &KPOINTS
      SCHEME MONKHORST-PACK 4 4 4
    &END KPOINTS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF   1.0E-7
      MAX_SCF   80
      ADDED_MOS 8
      &DIAGONALIZATION ON
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA  0.3
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &PRINT
      &PDOS
        NLUMO      -1
        COMPONENTS
      &END PDOS
    &END PRINT
  &END DFT
  &SUBSYS
    &CELL
      ABC 5.40 5.40 5.40
      PERIODIC XYZ
    &END CELL
    &COORD
      SCALED
      Si  0.00  0.00  0.00
      Si  0.00  0.50  0.50
      Si  0.50  0.00  0.50
      Si  0.50  0.50  0.00
      Si  0.25  0.25  0.25
      Si  0.25  0.75  0.75
      Si  0.75  0.25  0.75
      Si  0.75  0.75  0.25
    &END COORD
    &KIND Si
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q4
      POTENTIAL GTH-PBE-q4
    &END KIND
  &END SUBSYS
  &PRINT
    &STRESS_TENSOR ON
    &END STRESS_TENSOR
  &END PRINT
&END FORCE_EVAL
