%oldchk=lig_opt.chk
%chk=lig_esp.chk
%mem=8GB
%nprocshared=8
#p HF/6-31G(d) SCF=Tight Geom=Check Guess=Read NoSymm
   Pop=MK IOp(6/33=2,6/41=10,6/42=17,6/50=1)

Paracetamol HF/6-31G(d) Merz-Kollman ESP points for RESP

0 1

paracetamol.gesp

