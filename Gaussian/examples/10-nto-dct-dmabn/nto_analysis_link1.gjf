--Link1--
%oldchk=dmabn_opt.chk
%chk=dmabn_td.chk
%mem=8GB
%nprocshared=8
#p CAM-B3LYP/6-31+G(d) TD=(NStates=6) SCRF=(SMD,Solvent=Acetonitrile)
   Geom=Check Guess=Read IOp(9/40=4)

DMABN vertical excitations, CAM-B3LYP/6-31+G(d), SMD(acetonitrile)

0 1

--Link1--
%oldchk=dmabn_td.chk
%chk=dmabn_nto_s1.chk
%mem=8GB
%nprocshared=8
#p Geom=AllCheck Guess=(Read,Only) Density=(Check,Transition=1) Pop=(Minimal,NTO,SaveNTO)

--Link1--
%oldchk=dmabn_td.chk
%chk=dmabn_nto_s2.chk
%mem=8GB
%nprocshared=8
#p Geom=AllCheck Guess=(Read,Only) Density=(Check,Transition=2) Pop=(Minimal,NTO,SaveNTO)

--Link1--
%oldchk=dmabn_td.chk
%chk=dmabn_dct_s2.chk
%mem=8GB
%nprocshared=8
#p CAM-B3LYP/6-31+G(d) TD=(Read,NStates=6,Root=2) SCRF=(SMD,Solvent=Acetonitrile)
   Geom=AllCheck Guess=Read Density=Current Pop=DCT

