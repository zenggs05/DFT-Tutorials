# Part B: Gamma-point phonons by DFPT + LEPSILON
#   -> ionic contribution to the static dielectric tensor (eps_0 = eps_inf + eps_ion)
#   -> Born charges, Gamma phonon frequencies (TO modes)
# Use a fully relaxed structure with the same settings (here: zinc blende,
# forces vanish by symmetry at any lattice constant).
SYSTEM   = GaAs LEPSILON + IBRION=8 (ionic dielectric contribution)
PREC     = Accurate
ENCUT    = 400
EDIFF    = 1E-8
ISMEAR   = 0
SIGMA    = 0.01
LREAL    = .FALSE.

LEPSILON = .TRUE.
IBRION   = 8           # DFPT phonons with symmetry (no vdW corrections possible here)
NSW      = 1           # only needed by very old versions; harmless

LWAVE    = .FALSE.
LCHARG   = .FALSE.
# Do NOT set NCORE/NPAR.
