SYSTEM  = Si E-V scan (fixed volume, static)

PREC    = Accurate
ENCUT   = 400
EDIFF   = 1E-7
ISMEAR  = -5         # tetrahedron with Bloechl corrections: accurate total energy (semiconductor)
