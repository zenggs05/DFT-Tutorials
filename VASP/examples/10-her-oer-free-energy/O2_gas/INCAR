LREAL   = .FALSE.
LASPH   = .TRUE.

IBRION  = 2
ISIF    = 2
NSW     = 50
EDIFFG  = -0.02

LWAVE   = .FALSE.
LCHARG  = .FALSE.
LORBIT  = 11           # writes the magnetisation per atom to OUTCAR
