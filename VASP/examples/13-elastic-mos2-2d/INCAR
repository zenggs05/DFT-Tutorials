# Energy-strain method, one strained cell per directory.
# The cell is FIXED (ISIF=2); only atoms relax -> relaxed-ion constants.
SYSTEM  = MoS2 monolayer energy-strain point

# electronic
PREC    = Accurate
ENCUT   = 500          # same value for ALL strained cells
EDIFF   = 1E-7         # energy changes are only meV -> tight SCF
ISMEAR  = 0
SIGMA   = 0.05
LREAL   = .FALSE.

# ionic: relax internal coordinates at fixed (strained) cell
IBRION  = 2
ISIF    = 2
NSW     = 60
EDIFFG  = -1E-3        # eV/A

# output
LWAVE   = .FALSE.
LCHARG  = .FALSE.
